+      // On ARM64EC, code generation turns a call to an external function into
+      // a reference to its mangled name (#func) plus an anti-dependency alias
+      // func -> #func, and ARM64EC archives index only the mangled name. The
+      // bitcode symbol table has just the demangled name, so without the same
+      // alias here, archive members that LTO-generated code needs (e.g.
+      // libc++'s __gxx_personality_seh0) are never loaded and the mangled
+      // references stay undefined after LTO.
+      if (symtab.isEC() && objSym.isExecutable()) {
+        if (std::optional<std::string> mangledName =
+                getArm64ECMangledFunctionName(symName)) {
+          auto *u = dyn_cast<Undefined>(sym);
+          if (u && !u->weakAlias) {
+            Symbol *t =
+                symtab.addUndefined(saver.save(*mangledName), this, false);
+            u->setWeakAlias(t, true);
+          }
+        }
+      }

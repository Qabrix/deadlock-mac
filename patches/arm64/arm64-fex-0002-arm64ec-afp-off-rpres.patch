@@ -64,6 +64,14 @@ FEXCore::HostFeatures CPUFeatures::FetchHostFeatures(bool IsWine, FEXCore::HostF
 
   CPUFeaturesFromRegistry Features(Key);
 
+  if (HostType == FEXCore::HostFeatures::HostTypeEnum::Arm64ec) {
+    // (athei cc23d2cae79) Native ARM64EC code requires FPCR.AH and FPCR.NEP to be clear, so with AFP every transition
+    // between the JIT and native code writes FPCR twice (~9 ns each on Apple M-series). ARM64EC processes make these
+    // transitions far more often than the AFP code sequences save, so don't use AFP by default.
+    // HostFeatures=enableafp still turns it back on.
+    Features.RemoveFeature(FEX::CPUFeatures::Feature::AFP);
+  }

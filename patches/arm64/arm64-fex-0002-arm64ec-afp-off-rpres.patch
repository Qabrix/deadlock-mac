diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
index d036cd228..eed0ad4d0 100644
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -73,10 +73,16 @@ BeginSimulation:
   // Expects the target code address in x9
 .global ExitFunctionEC
 ExitFunctionEC:
-  // Clear any the AFP NEP and AH bits in FPCR as native code won't expect their behaviour.
+  // Clear the AFP NEP and AH bits in FPCR as native code won't expect their behaviour. Skip the write when they are
+  // already clear, which is always the case unless AFP is in use, as FPCR writes are slow on some hardware. NZCV still
+  // holds the guest flags here, so test the bits without touching it. (athei cc23d2cae79, adapted to LOAD_TEB)
   mrs x17, fpcr
+  tbnz x17, #1, 1f // AH
+  tbz x17, #2, 2f // NEP
+1:
   and x17, x17, #~6 // NEP + AH
   msr fpcr, x17
+2:
   LOAD_TEB x17, x16
   ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
   strb wzr, [x17, #0x0] // ChpeV2CpuAreaInfo->InSimulation
diff --git a/Source/Windows/Common/CPUFeatures.cpp b/Source/Windows/Common/CPUFeatures.cpp
index c033db8af..38deec19d 100644
--- a/Source/Windows/Common/CPUFeatures.cpp

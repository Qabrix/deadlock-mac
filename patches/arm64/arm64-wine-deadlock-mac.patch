+/* deadlock-gptk: WINE_MAC_WHEEL_RELEASE=<vkey>[:up|:down] (e.g. 0x20:up) - in mouse-look, a wheel notch (in that
+ * direction) while <vkey> is held first sends <vkey>'s release. A game with the wheel and that key on one action
+ * (Deadlock: Jump on SPACE + MWHEELUP) then sees the notch as a new press, so Space -> wheel at any speed is jump + air
+ * jump; otherwise the action is still down from Space and the notch does nothing. Until the key really comes up, its
+ * auto-repeats are dropped (they would press it again). */
+static WORD wheel_release_vkey;
+static int wheel_release_dir, wheel_release_init;
+static BOOL wheel_released;     /* release sent, key still physically down */
+
+void macdrv_wheel_release(HWND hwnd, int y_scroll, unsigned long time_ms)
+{
+    struct macdrv_thread_data *thread_data = macdrv_thread_data();
+    unsigned int i;
+
+    if (!wheel_release_init)
+    {
+        const char *s = getenv("WINE_MAC_WHEEL_RELEASE");
+        char *end;
+        wheel_release_init = 1;
+        if (s && *s)
+        {
+            wheel_release_vkey = strtoul(s, &end, 0);
+            if (!strcmp(end, ":up")) wheel_release_dir = 1;
+            else if (!strcmp(end, ":down")) wheel_release_dir = -1;
+        }
+    }
+    if (!wheel_release_vkey || !thread_data) return;
+    if (wheel_release_dir && (y_scroll > 0 ? 1 : -1) != wheel_release_dir) return;
+    if (!(NtUserGetAsyncKeyState(wheel_release_vkey) & 0x8000))
+    {
+        macdrv_wheel_log("%lu wheel-out y=%d key 0x%x up: nothing to release\n", time_ms, y_scroll, wheel_release_vkey);
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(thread_data->keyc2vkey); i++)
+    {
+        if (thread_data->keyc2vkey[i] != wheel_release_vkey) continue;
+        TRACE_(key)("wheel: releasing vkey 0x%x\n", wheel_release_vkey);
+        macdrv_send_keyboard_input(hwnd, wheel_release_vkey, thread_data->keyc2scan[i] & 0xff,
+                                   KEYEVENTF_KEYUP | ((thread_data->keyc2scan[i] & 0x100) ? KEYEVENTF_EXTENDEDKEY : 0),
+                                   time_ms);
+        wheel_released = TRUE;
+        macdrv_wheel_log("%lu wheel-out y=%d key 0x%x was down: release sent (hwnd %p)\n", time_ms, y_scroll,
+                         wheel_release_vkey, hwnd);
+        return;
+    }
+}

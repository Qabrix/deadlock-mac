+/* main thread, only when the rows, the status, running or the screen change */
+static void parkour_redraw(void)
+{
+    NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
+    NSMutableString *rows = [NSMutableString string];
+    BOOL status = parkour_status && now < parkour_status_until;
+    NSWindow *game = [NSApp keyWindow] ? [NSApp keyWindow] : [NSApp mainWindow];
+    NSScreen *screen = [game screen] ? [game screen] : [NSScreen mainScreen];
+    CGFloat scale = [screen backingScaleFactor];
+    NSSize rows_size = NSZeroSize, clock_size = NSZeroSize, status_size = NSZeroSize, size;
+    NSRect area = [screen frame], frame;
+    NSUInteger i;
+
+    for (i = 0; i < [parkour_rows count]; i++)
+        [rows appendFormat:@"%@%2lu   %@", i ? @"\n" : @"", (unsigned long)i + 1, [parkour_rows objectAtIndex:i]];
+
+    if (!parkour_running && parkour_tick)
+    {
+        dispatch_source_cancel(parkour_tick);
+        dispatch_release(parkour_tick);
+        parkour_tick = NULL;
+    }
+    if (status)
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((parkour_status_until - now + 0.05) * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{ parkour_redraw(); });
+    if (parkour_frame_active())
+    {
+        [parkour_panel orderOut:nil];
+        parkour_frame_update(rows, status ? parkour_status : nil);
+        return;
+    }
+
+    if (![rows length] && !parkour_running && !status)
+    {
+        [parkour_panel orderOut:nil];
+        return;
+    }
+    if (!parkour_panel)
+    {
+        NSView *content;
+        CALayer *root = [CALayer layer];
+
+        parkour_panel = [[NSPanel alloc] initWithContentRect:NSMakeRect(0, 0, 10, 10)
+                                                   styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel
+                                                     backing:NSBackingStoreBuffered
+                                                       defer:YES];
+        [parkour_panel setOpaque:NO];
+        [parkour_panel setBackgroundColor:[NSColor clearColor]];
+        [parkour_panel setHasShadow:NO];
+        [parkour_panel setIgnoresMouseEvents:YES];
+        [parkour_panel setReleasedWhenClosed:NO];
+        [parkour_panel setHidesOnDeactivate:YES];
+        [parkour_panel setCollectionBehavior:NSWindowCollectionBehaviorCanJoinAllSpaces |
+                                             NSWindowCollectionBehaviorFullScreenAuxiliary |
+                                             NSWindowCollectionBehaviorStationary |
+                                             NSWindowCollectionBehaviorIgnoresCycle];
+        root.backgroundColor = [[NSColor colorWithCalibratedWhite:0 alpha:0.55] CGColor];
+        root.cornerRadius = 8;
+        root.geometryFlipped = YES;
+        content = [parkour_panel contentView];
+        [content setLayer:root];        /* layer-hosting: plain layers, no AppKit view drawing */
+        [content setWantsLayer:YES];
+        parkour_rows_layer = parkour_text_layer(root, scale);
+        parkour_clock = parkour_text_layer(root, scale);
+        parkour_status_layer = parkour_text_layer(root, scale);
+    }
+
+    if ([rows length]) rows_size = [parkour_string(rows) size];
+    /* room for minutes, so the panel doesn't grow while the clock runs */
+    if (parkour_running) clock_size = [parkour_string(parkour_clock_text(MAX(now - parkour_start, 600))) size];
+    if (status) status_size = [parkour_string(parkour_status) size];
+    size = NSMakeSize(ceil(MAX(rows_size.width, MAX(clock_size.width, status_size.width))),
+                      ceil(rows_size.height + clock_size.height + status_size.height));
+
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    parkour_rows_layer.string = [rows length] ? parkour_string(rows) : nil;
+    parkour_rows_layer.frame = CGRectMake(12, 8, size.width, rows_size.height);
+    parkour_clock.hidden = !parkour_running;
+    parkour_clock.frame = CGRectMake(12, 8 + rows_size.height, size.width, clock_size.height);
+    parkour_status_layer.string = status ? parkour_string(parkour_status) : nil;
+    parkour_status_layer.frame = CGRectMake(12, 8 + rows_size.height + clock_size.height, size.width, status_size.height);
+    parkour_rows_layer.contentsScale = parkour_clock.contentsScale = parkour_status_layer.contentsScale = scale;
+    [CATransaction commit];
+
+    if (parkour_running && !parkour_tick)
+    {
+        parkour_set_clock(now - parkour_start);
+        parkour_tick = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, parkour_draw_queue);
+        dispatch_source_set_timer(parkour_tick, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC),
+                                  100 * NSEC_PER_MSEC, 5 * NSEC_PER_MSEC);
+        dispatch_source_set_event_handler(parkour_tick, ^{
+            parkour_set_clock([[NSProcessInfo processInfo] systemUptime] - parkour_start);
+        });
+        dispatch_resume(parkour_tick);
+    }
+    else if (parkour_running)
+        parkour_set_clock(now - parkour_start);   /* E restarted it */
+
+    frame = NSMakeRect(NSMaxX(area) - size.width - 24 - 24, NSMaxY(area) - area.size.height * 0.3 - size.height - 16,
+                       size.width + 24, size.height + 16);
+    if (!NSEqualRects(frame, [parkour_panel frame])) [parkour_panel setFrame:frame display:NO];
+    if ([parkour_panel level] < MAX(NSScreenSaverWindowLevel, [game level] + 1))
+        [parkour_panel setLevel:MAX(NSScreenSaverWindowLevel, [game level] + 1)];
+    if (![parkour_panel isVisible]) [parkour_panel orderFrontRegardless];
+}

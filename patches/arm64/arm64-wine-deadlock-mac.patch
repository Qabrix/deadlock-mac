+    else if (!strncmp(end, ":down", 5)) { wheel_repress_dir = -1; end += 5; }
+    if (*end == ':') wheel_repress_ms = atoi(end + 1);
+    if (wheel_repress_key < 0 || wheel_repress_key > 127) wheel_repress_key = -1;
+}
+
+/* physical key state from the key events Wine receives (CGEventSourceKeyState of the HID state can need Input
+ * Monitoring permission); main thread only, like the scroll handler */
+static unsigned char wheel_keys_down[128];
+static NSTimeInterval wheel_keys_press_time[128];   /* last non-repeat press, NSEvent timestamp (uptime) */
+static BOOL wheel_pending;                          /* a delayed wheel jump is queued */
+
+/* deadlock-gptk: WINE_MAC_WHEEL_RAW_AFTER_PAIR=<pair ms>[:<window ms>] (default off; the launchers set 400:1500) - two
+ * presses of the WINE_MAC_WHEEL_REPRESS key less than <pair ms> apart (Deadlock: Space-Space = jump + air jump) make
+ * the wheel raw for <window ms> after the second press: in that direction every scroll event is a notch (no gate)
+ * and none is held back (no WINE_MAC_WHEEL_AFTER_KEY_MS), for wall jumps at full wheel speed. A single press of
+ * the key ends it (Space -> wheel keeps its hold). A held key is still re-pressed. */
+static double wheel_raw_pair_ms = -1, wheel_raw_window_ms;
+static NSTimeInterval wheel_raw_until;
+
+static void wheel_raw_init(void)
+{
+    const char *s;
+    char *end;
+
+    if (wheel_raw_pair_ms >= 0) return;
+    wheel_raw_pair_ms = 0;
+    wheel_raw_window_ms = 1500;
+    if (!(s = getenv("WINE_MAC_WHEEL_RAW_AFTER_PAIR")) || !*s) return;
+    wheel_raw_pair_ms = strtod(s, &end);
+    if (*end == ':') wheel_raw_window_ms = atof(end + 1);
+    if (wheel_raw_pair_ms < 0) wheel_raw_pair_ms = 0;
+}
+
+void macdrv_wheel_note_key(unsigned short keycode, int pressed, int repeat, double timestamp)
+{
+    if (keycode >= sizeof(wheel_keys_down)) return;
+    wheel_keys_down[keycode] = pressed != 0;
+    if (pressed && !repeat)
+    {
+        double apart = (timestamp - wheel_keys_press_time[keycode]) * 1000;
+
+        wheel_repress_init();
+        wheel_raw_init();
+        if (keycode == wheel_repress_key && apart < wheel_raw_pair_ms)
+        {
+            wheel_raw_until = timestamp + wheel_raw_window_ms / 1000;
+            macdrv_wheel_log("key %d pressed twice %.0f ms apart: wheel raw for %.0f ms\n", keycode, apart,
+                             wheel_raw_window_ms);
+        }
+        else if (keycode == wheel_repress_key && wheel_raw_until > timestamp)
+        {
+            wheel_raw_until = 0;
+            macdrv_wheel_log("key %d pressed once: wheel raw off\n", keycode);
+        }
+        wheel_keys_press_time[keycode] = timestamp;
+    }
+}
+
+/* deadlock-gptk: WINE_MAC_WHEEL_AFTER_KEY_MS=<ms> (default 0 = off; the launchers set 160) - a wheel notch less than
+ * <ms> after the last press of the WINE_MAC_WHEEL_REPRESS key is held back until <ms> after that press. Deadlock's
+ * Jump ability has a 0.15 s cooldown (scripts/abilities.vdata citadel_ability_jump AbilityCooldown), so a wheel jump
+ * 60-140 ms after Space was ignored; now it lands just after the cooldown. One notch is still one press. */
+static double wheel_after_key_ms(void)
+{
+    static double ms = -1;
+    if (ms < 0)
+    {
+        const char *s = getenv("WINE_MAC_WHEEL_AFTER_KEY_MS");
+        ms = s && *s ? atof(s) : 0;
+        if (ms < 0) ms = 0;
+    }
+    return ms;
+}
+
+static void wheel_post_scroll(WineWindow *window, int x, int y, int y_scroll)
+{
+    macdrv_event *event = macdrv_create_event(MOUSE_SCROLL, window);
+
+    event->mouse_scroll.x = x;
+    event->mouse_scroll.y = y;
+    event->mouse_scroll.y_scroll = y_scroll;
+    event->mouse_scroll.look = 1;
+    event->mouse_scroll.time_ms = [[WineApplicationController sharedController]
+                                   ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+    [window.queue postEvent:event];
+    macdrv_release_event(event);
+}
+
+static void wheel_post_key(WineWindow *window, CGKeyCode key, BOOL pressed, CGEventFlags modifiers)
+{
+    macdrv_event *event = macdrv_create_event(pressed ? KEY_PRESS : KEY_RELEASE, window);
+
+    event->key.keycode = key;
+    event->key.modifiers = modifiers;
+    event->key.time_ms = [[WineApplicationController sharedController]
+                          ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+    [window.queue postEvent:event];
+    macdrv_release_event(event);
+}
+
+/* deadlock-gptk: WINE_MAC_WHEEL_LOG=<unix path> - one line per wheel notch and per press/release of the
+ * WINE_MAC_WHEEL_RELEASE key: what the gate and the release did (diagnostics, a few lines per jump). */
+#include <stdarg.h>
+void macdrv_wheel_log(const char *fmt, ...)
+{
+    static FILE *f;
+    static int init;
+    va_list args;
+
+    if (!init)
+    {
+        const char *path = getenv("WINE_MAC_WHEEL_LOG");
+        init = 1;
+        if (path && *path && (f = fopen(path, "a"))) setvbuf(f, NULL, _IOLBF, 0);
+    }
+    if (!f) return;
+    va_start(args, fmt);
+    vfprintf(f, fmt, args);
+    va_end(args);
+}
+
+/* deadlock-gptk: WINE_MAC_PARKOUR=<unix path of the game's citadel folder> (./deadlock.sh --parkour, which also starts
+ * the game with +exec dl_parkour_init = bind F9 "exec dl_parkour") - practice helpers for maps with sv_cheats, in
+ * mouse-look only (menus, chat and console get the keys as usual):
+ *   Q  checkpoint: runs "getpos_exact", keeps its "setpos_exact ...;setang_exact ..." reply from console.log (-condebug)
+ *   E  teleport to the checkpoint, WINE_MAC_PARKOUR_LIFT (16) units higher: setpos_exact turns noclip on when the
+ *      spot counts as stuck, which a spot on the floor (and 2 units above it) did; "noclip 0" after it in case. Optional
+ *      WINE_MAC_PARKOUR_REFRESH (e.g. "citadel_rapid_stamina_regen 1") and WINE_MAC_PARKOUR_REFRESH_OFF
+ *      WINE_MAC_PARKOUR_REFRESH_MS (1000) later. Restarts the stopwatch. E also reaches the game (Interact: the
+ *      hideout's portals), so without a checkpoint it is only Interact
+ *   T  stopwatch start / stop; a stop adds the time as a row below the previous ones
+ *   H  clear the rows and stop the stopwatch; with nothing left to clear, forget the checkpoint (E = Interact only)
+ * Q, T and H don't reach the game. A command runs by writing it to cfg/dl_parkour.cfg and pressing F9 for the game
+ * (Deadlock's release build doesn't open a net console for -netconport). The overlay is a click-through panel of this
+ * process above the game window, shown only while it has something on it. Main thread, except reading console.log. */
+#include <sys/stat.h>
+#include <unistd.h>
+
+enum { PARKOUR_KEY_Q = 12, PARKOUR_KEY_E = 14, PARKOUR_KEY_T = 17, PARKOUR_KEY_H = 4, PARKOUR_KEY_EXEC = 101 /* F9 */ };
+
+static int parkour_on = -1;
+static char parkour_cfg[1024], parkour_log[1024], parkour_map_cfg[1024];
+static int parkour_map_state;                /* map reload: 0 not yet, 1 scheduled, 2 done or nothing to do */
+static const char *parkour_refresh, *parkour_refresh_off;
+static double parkour_refresh_ms, parkour_lift;
+static BOOL parkour_off_pending;             /* the refresh-off command is still to run */
+static dispatch_queue_t parkour_queue;
+static NSString *parkour_checkpoint;
+static unsigned parkour_ask_id;              /* the latest Q */
+static unsigned char parkour_swallowed[128];
+static NSMutableArray *parkour_rows;
+static BOOL parkour_running;
+static NSTimeInterval parkour_start;
+static NSString *parkour_status;
+static NSTimeInterval parkour_status_until;
+static NSPanel *parkour_panel;
+static CATextLayer *parkour_rows_layer, *parkour_clock, *parkour_status_layer;
+static NSDictionary *parkour_attrs;
+static dispatch_queue_t parkour_draw_queue;     /* the clock's 10 Hz tick / the frame overlay's renders */
+static dispatch_source_t parkour_tick;
+
+static BOOL parkour_mouselook(void);
+static void parkour_redraw(void);
+
+/* the console channel: WINE_MAC_PARKOUR's folder, else WINE_MAC_CONSOLE (the launchers set it always; it does
+ * nothing unless the game was started with +exec dl_parkour_init, i.e. --parkour or --map) */
+static BOOL parkour_channel(void)
+{
+    static int on;
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        const char *dir = getenv("WINE_MAC_PARKOUR");
+
+        if (!dir || !*dir) dir = getenv("WINE_MAC_CONSOLE");
+        on = dir && *dir;
+        if (on)
+        {
+            snprintf(parkour_cfg, sizeof(parkour_cfg), "%s/cfg/dl_parkour.cfg", dir);
+            snprintf(parkour_log, sizeof(parkour_log), "%s/console.log", dir);
+            snprintf(parkour_map_cfg, sizeof(parkour_map_cfg), "%s/cfg/dl_map_reload.cfg", dir);
+        }
+    });
+    return on;
+}
+
+static BOOL parkour_enabled(void)
+{
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        const char *dir = getenv("WINE_MAC_PARKOUR");
+        parkour_on = dir && *dir && parkour_channel();
+        if (parkour_on)
+        {
+            const char *ms = getenv("WINE_MAC_PARKOUR_REFRESH_MS"), *lift = getenv("WINE_MAC_PARKOUR_LIFT");
+            parkour_refresh = getenv("WINE_MAC_PARKOUR_REFRESH");
+            if (!parkour_refresh) parkour_refresh = "";
+            parkour_refresh_off = getenv("WINE_MAC_PARKOUR_REFRESH_OFF");
+            if (!parkour_refresh_off) parkour_refresh_off = "";
+            parkour_refresh_ms = ms && *ms ? atof(ms) : 1000;
+            parkour_lift = lift && *lift ? atof(lift) : 16;
+            parkour_queue = dispatch_queue_create("deadlock-gptk.parkour", DISPATCH_QUEUE_SERIAL);
+            parkour_draw_queue = dispatch_queue_create("deadlock-gptk.parkour-draw",
+                dispatch_queue_attr_make_with_autorelease_frequency(DISPATCH_QUEUE_SERIAL,
+                                                                    DISPATCH_AUTORELEASE_FREQUENCY_WORK_ITEM));
+            parkour_attrs = [@{ NSFontAttributeName: [NSFont monospacedDigitSystemFontOfSize:20 weight:NSFontWeightSemibold],
+                                NSForegroundColorAttributeName: [NSColor whiteColor] } retain];
+            parkour_rows = [[NSMutableArray alloc] init];
+        }
+    });
+    return parkour_on;
+}
+
+static void parkour_show_status(NSString *text)
+{
+    [parkour_status release];
+    parkour_status = [text copy];
+    parkour_status_until = [[NSProcessInfo processInfo] systemUptime] + 2.5;
+    parkour_redraw();
+}
+
+/* the game runs <command>: cfg/dl_parkour.cfg (written whole, then renamed) + F9 down, up 30 ms later */
+static BOOL parkour_exec(NSString *command)
+{
+    WineWindow *window = (WineWindow *)[NSApp keyWindow];
+    char tmp[1100];
+    FILE *f;
+
+    if (![window isKindOfClass:[WineWindow class]]) return NO;
+    if (parkour_off_pending)
+    {
+        parkour_off_pending = NO;
+        command = [NSString stringWithFormat:@"%s;%@", parkour_refresh_off, command];
+    }
+    snprintf(tmp, sizeof(tmp), "%s.tmp", parkour_cfg);
+    if (!(f = fopen(tmp, "w")))
+    {
+        macdrv_wheel_log("parkour: can't write %s\n", tmp);
+        return NO;
+    }
+    fprintf(f, "%s\n", [command UTF8String]);
+    fclose(f);
+    if (rename(tmp, parkour_cfg)) return NO;
+    wheel_post_key(window, PARKOUR_KEY_EXEC, TRUE, 0);
+    [window retain];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        wheel_post_key(window, PARKOUR_KEY_EXEC, FALSE, 0);
+        [window release];
+    });
+    return YES;
+}
+
+/* Q: getpos_exact, then up to 2 s of console.log lines for "setpos... setang..." (one line, or setang on the next) */
+static void parkour_ask_position(void)
+{
+    struct stat st;
+    off_t from = stat(parkour_log, &st) ? 0 : st.st_size;
+    unsigned id = ++parkour_ask_id;
+
+    if (!parkour_exec(@"getpos_exact"))
+    {
+        parkour_show_status(@"can't run game commands");
+        return;
+    }
+    dispatch_async(parkour_queue, ^{
+        NSMutableString *found = nil;
+        BOOL done = NO;
+        char line[4096];
+        off_t pos = from;
+        FILE *f = fopen(parkour_log, "r");
+        int i;
+
+        for (i = 0; f && !done && i < 80; i++)
+        {
+            usleep(25000);
+            clearerr(f);
+            if (fseeko(f, pos, SEEK_SET)) break;
+            while (!done && fgets(line, sizeof(line), f))
+            {
+                size_t n = strlen(line);
+                const char *p;
+
+                if (line[n - 1] != '\n' && n < sizeof(line) - 1) break;   /* still being written */
+                pos += n;
+                line[strcspn(line, "\r\n")] = 0;
+                if (!found && (p = strstr(line, "setpos")))
+                {
+                    found = [[NSMutableString alloc] initWithUTF8String:p];
+                    done = found && strstr(p, "setang");
+                }
+                else if (found && (p = strstr(line, "setang")))
+                {
+                    [found appendFormat:@";%s", p];
+                    done = YES;
+                }
+            }
+        }
+        if (f) fclose(f);
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (id == parkour_ask_id)
+            {
+                double x, y, z;
+                const char *ang;
+
+                if (found && sscanf([found UTF8String], "setpos_exact %lf %lf %lf", &x, &y, &z) == 3 &&
+                    (ang = strchr([found UTF8String], ';')))
+                    [found setString:[NSString stringWithFormat:@"setpos_exact %f %f %f%s", x, y, z + parkour_lift, ang]];
+                if (found)
+                {
+                    [parkour_checkpoint release];
+                    parkour_checkpoint = [found copy];
+                    macdrv_wheel_log("parkour: checkpoint %s\n", [found UTF8String]);
+                    parkour_show_status(@"checkpoint set");
+                }
+                else
+                {
+                    macdrv_wheel_log("parkour: no getpos_exact reply in %s\n", parkour_log);
+                    parkour_show_status(@"no reply - console: exec dl_parkour_init");
+                }
+            }
+            [found release];
+        });
+    });
+}
+
+/* ./deadlock.sh --map: a custom map's own data (its hero) is only in use from its second load, and the load has
+ * to be a finished one (a "map" during loading restarts it). tools/map-cfg.sh writes the command into
+ * cfg/dl_map_reload.cfg; the first mouse-look of the process (the player is in the map: only the game captures the
+ * cursor, and not on the loading screen) runs it once, 2 s later. Called on every mouse move in mouse-look. */
+static void parkour_map_reload_kick(void)
+{
+    if (parkour_map_state || !parkour_channel()) return;
+    parkour_map_state = 1;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        char line[256] = "";
+        FILE *f = fopen(parkour_map_cfg, "r");
+
+        if (f)
+        {
+            while (fgets(line, sizeof(line), f) && (line[0] == '/' || line[0] == '\n')) line[0] = 0;
+            fclose(f);
+        }
+        line[strcspn(line, "\r\n")] = 0;
+        if (!line[0])
+            parkour_map_state = 2;
+        else if (!parkour_mouselook())
+            parkour_map_state = 0;           /* left mouse-look meanwhile: the next one tries again */
+        else if (parkour_exec([NSString stringWithUTF8String:line]))
+        {
+            parkour_map_state = 2;
+            macdrv_wheel_log("parkour: map reload: %s\n", line);
+        }
+        else
+            parkour_map_state = 0;
+    });
+}
+
+static NSString *parkour_format(double s)
+{
+    if (s < 60) return [NSString stringWithFormat:@"%.3f", s];
+    return [NSString stringWithFormat:@"%d:%06.3f", (int)(s / 60), fmod(s, 60)];
+}
+
+static NSAttributedString *parkour_string(NSString *s)
+{
+    return [[[NSAttributedString alloc] initWithString:s attributes:parkour_attrs] autorelease];
+}
+
+/* the running line: tenths, so 10 updates/s; the row added at stop has milliseconds */
+static NSString *parkour_clock_text(double s)
+{
+    s = floor(s * 10) / 10;
+    if (s < 60) return [NSString stringWithFormat:@" ▶   %.1f", s];
+    return [NSString stringWithFormat:@" ▶   %d:%04.1f", (int)(s / 60), fmod(s, 60)];
+}
+
+/* any thread: Core Animation is thread-safe inside an explicit transaction, so the tick never touches the main
+ * thread (Wine's input thread) */
+static void parkour_set_clock(double elapsed)
+{
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    parkour_clock.string = parkour_string(parkour_clock_text(elapsed));
+    [CATransaction commit];
+}
+
+static CATextLayer *parkour_text_layer(CALayer *parent, CGFloat scale)
+{
+    CATextLayer *layer = [CATextLayer layer];
+
+    layer.contentsScale = scale;
+    layer.anchorPoint = CGPointZero;
+    [parent addSublayer:layer];
+    return layer;
+}
+
+/* --- the overlay inside the game's frame (DXMT, our builds) ---
+ * The panel above was a window over the game, so the window server composited every frame while it showed. DXMT's
+ * present pass instead calls macdrv_parkour_overlay_lock (winemetal, dlsym) for each frame and, when the version
+ * changed, copies the bitmap into a texture it blends over the drawable. The bitmap is rendered here on
+ * parkour_draw_queue: on every change of rows/status/running, and 10x/s while the stopwatch runs. The first call
+ * from DXMT switches the panel off for good. */
+#include <os/lock.h>
+
+static os_unfair_lock parkour_frame_lock = OS_UNFAIR_LOCK_INIT;
+static BOOL parkour_frame_seen;              /* DXMT asked: draw into the frame, no panel */
+static NSString *parkour_frame_rows, *parkour_frame_status;  /* snapshot of the main thread's state */
+static BOOL parkour_frame_running;
+static NSTimeInterval parkour_frame_start;
+static void *parkour_frame_pixels;           /* premultiplied BGRA, top row first */
+static uint32_t parkour_frame_width, parkour_frame_height;
+static uint64_t parkour_frame_version;
+static double parkour_frame_scale = 1, parkour_frame_rendered_scale;
+static dispatch_source_t parkour_frame_tick;
+
+static CTLineRef parkour_frame_line(NSString *text, CTFontRef font)
+{
+    NSAttributedString *s = [[NSAttributedString alloc] initWithString:text
+                                                            attributes:@{ (id)kCTFontAttributeName: (id)font,
+                                                                          (id)kCTForegroundColorFromContextAttributeName: @YES }];
+    CTLineRef line = CTLineCreateWithAttributedString((CFAttributedStringRef)s);
+
+    [s release];
+    return line;
+}
+
+/* parkour_draw_queue */
+static void parkour_frame_render(void)
+{
+    NSString *rows, *status;
+    BOOL running;
+    NSTimeInterval start;
+    double scale;
+    NSMutableArray *texts = [NSMutableArray array];
+    void *pixels = NULL;
+    uint32_t width = 0, height = 0;
+
+    os_unfair_lock_lock(&parkour_frame_lock);
+    rows = [parkour_frame_rows retain];
+    status = [parkour_frame_status retain];
+    running = parkour_frame_running;
+    start = parkour_frame_start;
+    scale = parkour_frame_scale;
+    os_unfair_lock_unlock(&parkour_frame_lock);
+
+    if ([rows length]) [texts addObjectsFromArray:[rows componentsSeparatedByString:@"\n"]];
+    if (running) [texts addObject:parkour_clock_text([[NSProcessInfo processInfo] systemUptime] - start)];
+    if ([status length]) [texts addObject:status];
+
+    if ([texts count])
+    {
+        CTFontRef font = CTFontCreateCopyWithAttributes((CTFontRef)[parkour_attrs objectForKey:NSFontAttributeName],
+                                                        20 * scale, NULL, NULL);
+        CGFloat ascent = CTFontGetAscent(font), descent = CTFontGetDescent(font), leading = CTFontGetLeading(font);
+        CGFloat line_height = ceil(ascent + descent + leading), pad_x = ceil(12 * scale), pad_y = ceil(8 * scale);
+        CGFloat text_width = 0;
+        NSMutableArray *lines = [NSMutableArray array];
+        CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+        CGContextRef ctx;
+        NSUInteger i;
+
+        if (running)   /* room for minutes: the box doesn't grow while the clock runs */
+        {
+            CTLineRef wide = parkour_frame_line(parkour_clock_text(600), font);
+            text_width = CTLineGetTypographicBounds(wide, NULL, NULL, NULL);
+            CFRelease(wide);
+        }
+        for (NSString *text in texts)
+        {
+            CTLineRef line = parkour_frame_line(text, font);
+            text_width = MAX(text_width, CTLineGetTypographicBounds(line, NULL, NULL, NULL));
+            [lines addObject:(id)line];
+            CFRelease(line);
+        }
+        width = MIN(512, (uint32_t)ceil(text_width + 2 * pad_x));
+        height = MIN(1024, (uint32_t)(line_height * [lines count] + 2 * pad_y));
+        pixels = calloc((size_t)width * height, 4);
+        ctx = CGBitmapContextCreate(pixels, width, height, 8, width * 4, srgb,
+                                    kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
+        if (ctx)
+        {
+            CGPathRef box = CGPathCreateWithRoundedRect(CGRectMake(0, 0, width, height), 8 * scale, 8 * scale, NULL);
+            CGContextSetRGBFillColor(ctx, 0, 0, 0, 0.55);
+            CGContextAddPath(ctx, box);
+            CGContextFillPath(ctx);
+            CGPathRelease(box);
+            CGContextSetRGBFillColor(ctx, 1, 1, 1, 1);
+            for (i = 0; i < [lines count]; i++)
+            {
+                CGContextSetTextPosition(ctx, pad_x, height - pad_y - ascent - line_height * i);
+                CTLineDraw((CTLineRef)[lines objectAtIndex:i], ctx);
+            }
+            CGContextRelease(ctx);
+        }
+        else
+        {
+            free(pixels);
+            pixels = NULL;
+            width = height = 0;
+        }
+        CGColorSpaceRelease(srgb);
+        CFRelease(font);
+    }
+    [rows release];
+    [status release];
+
+    os_unfair_lock_lock(&parkour_frame_lock);
+    free(parkour_frame_pixels);
+    parkour_frame_pixels = pixels;
+    parkour_frame_width = width;
+    parkour_frame_height = height;
+    parkour_frame_rendered_scale = scale;
+    parkour_frame_version++;
+    os_unfair_lock_unlock(&parkour_frame_lock);
+}
+
+/* main thread: the panel's job when DXMT draws the overlay */
+static void parkour_frame_update(NSString *rows, NSString *status)
+{
+    os_unfair_lock_lock(&parkour_frame_lock);
+    [parkour_frame_rows release];
+    parkour_frame_rows = [rows copy];
+    [parkour_frame_status release];
+    parkour_frame_status = [status copy];
+    parkour_frame_running = parkour_running;
+    parkour_frame_start = parkour_start;
+    os_unfair_lock_unlock(&parkour_frame_lock);
+
+    dispatch_async(parkour_draw_queue, ^{ parkour_frame_render(); });
+    if (parkour_running && !parkour_frame_tick)
+    {
+        parkour_frame_tick = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, parkour_draw_queue);
+        dispatch_source_set_timer(parkour_frame_tick, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC),
+                                  100 * NSEC_PER_MSEC, 5 * NSEC_PER_MSEC);
+        dispatch_source_set_event_handler(parkour_frame_tick, ^{ parkour_frame_render(); });
+        dispatch_resume(parkour_frame_tick);
+    }
+    else if (!parkour_running && parkour_frame_tick)
+    {
+        dispatch_source_cancel(parkour_frame_tick);
+        dispatch_release(parkour_frame_tick);
+        parkour_frame_tick = NULL;
+    }
+}

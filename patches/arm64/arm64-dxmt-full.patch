+}
+
+static void
+latewarp_dump(FILE *f, ParametersImpl *parameters) {
+  parameters->ForEach([f](const std::string &name, const Parameter &value) {
+    std::visit(
+        overloads{
+            [&](ID3D11Resource *r) {
+              fprintf(f, "  %s = res %p", name.c_str(), (void *)r);
+              Com<ID3D11Texture2D> tex;
+              if (r && SUCCEEDED(r->QueryInterface(IID_PPV_ARGS(&tex)))) {
+                D3D11_TEXTURE2D_DESC d = {};
+                tex->GetDesc(&d);
+                fprintf(f, " tex %ux%u fmt %u bind 0x%x samples %u", d.Width, d.Height, (unsigned)d.Format,
+                        d.BindFlags, d.SampleDesc.Count);
+              }
+              fprintf(f, "\n");
+            },
+            [&](void *p) {
+              fprintf(f, "  %s = ptr %p", name.c_str(), p);
+              if (p && name.find("Matrix") != std::string::npos) {
+                const float *m = static_cast<const float *>(p);
+                for (int i = 0; i < 16; i++)
+                  fprintf(f, "%s%.4f", i ? " " : " [", m[i]);
+                fprintf(f, "]");
+              }
+              fprintf(f, "\n");
+            },
+            [&](float x) { fprintf(f, "  %s = float %g\n", name.c_str(), x); },
+            [&](double x) { fprintf(f, "  %s = double %g\n", name.c_str(), x); },
+            [&](unsigned int x) { fprintf(f, "  %s = uint %u\n", name.c_str(), x); },
+            [&](int x) { fprintf(f, "  %s = int %d\n", name.c_str(), x); },
+            [&](unsigned long long x) { fprintf(f, "  %s = u64 %llu\n", name.c_str(), x); },
+            [&](ID3D12Resource *r) { fprintf(f, "  %s = d3d12 %p\n", name.c_str(), (void *)r); },
+        },
+        value
+    );
+  });
+}
+
+/* rotation between the 3x3 parts of two view matrices (same convention): trace(A^T B) = 1 + 2 cos(theta) */
+static double
+latewarp_rotation_deg(const float *a, const float *b) {
+  double t = 0;
+  for (int r = 0; r < 3; r++)
+    for (int c = 0; c < 3; c++)
+      t += (double)a[r * 4 + c] * b[r * 4 + c];
+  return std::acos(std::clamp((t - 1) / 2, -1.0, 1.0)) * (180.0 / 3.14159265358979323846);
+}
+
+static void
+latewarp_rect(ParametersImpl *parameters, const char *base, ID3D11Resource *r, D3D11_BOX &box) {
+  D3D11_TEXTURE2D_DESC d = {};
+  Com<ID3D11Texture2D> tex;
+  if (r && SUCCEEDED(r->QueryInterface(IID_PPV_ARGS(&tex))))
+    tex->GetDesc(&d);
+  unsigned x = 0, y = 0, w = 0, h = 0;
+  char key[96];
+  snprintf(key, sizeof(key), "%s.Subrect.Base.X", base);
+  parameters->Get(key, &x);
+  snprintf(key, sizeof(key), "%s.Subrect.Base.Y", base);
+  parameters->Get(key, &y);
+  snprintf(key, sizeof(key), "%s.Subrect.Width", base);
+  parameters->Get(key, &w);
+  snprintf(key, sizeof(key), "%s.Subrect.Height", base);
+  parameters->Get(key, &h);
+  if (!w || x + w > d.Width)
+    w = d.Width > x ? d.Width - x : 0;
+  if (!h || y + h > d.Height)
+    h = d.Height > y ? d.Height - y : 0;
+  box = {x, y, 0, x + w, y + h, 1};
+}
+
+static NVNGX_RESULT
+latewarp_evaluate(ID3D11DeviceContext *context, LateWarpFeature *lw, ParametersImpl *parameters) {
+  lw->evaluations++;
+  FILE *f = latewarp_log();
+  if (f && (lw->evaluations <= 3 || lw->evaluations % 600 == 0)) {
+    fprintf(f, "evaluate #%llu (feature output %ux%u):\n", (unsigned long long)lw->evaluations, lw->width, lw->height);
+    latewarp_dump(f, parameters);
+    fflush(f);
+  }
+
+  void *late = nullptr, *rendered = nullptr;
+  parameters->Get("Latewarp.WorldToViewMatrix", &late);
+  parameters->Get("Latewarp.PrevRenderedWorldToViewMatrix", &rendered);
+  if (late && rendered) {
+    double a = latewarp_rotation_deg(static_cast<const float *>(rendered), static_cast<const float *>(late));
+    lw->angle_sum += a;
+    lw->angle_max = std::max(lw->angle_max, a);
+    lw->angle_n++;
+  }
+  unsigned is_rendered = 1;
+  if (!(NVNGX_FAILED(parameters->Get("Latewarp.IsRenderedFrame", &is_rendered))) && !is_rendered)
+    lw->not_rendered++;
+
+  /* pass-through: the unwarped frame goes to the output */
+  ID3D11Resource *backbuffer = nullptr, *output = nullptr;
+  parameters->Get("Latewarp.Backbuffer", &backbuffer);
+  if (NVNGX_FAILED(parameters->Get("Latewarp.Output", &output)) || !output)
+    parameters->Get(NVNGX_Parameter_Output, &output);
+  if (backbuffer && output && backbuffer != output) {
+    D3D11_BOX src, dst;
+    latewarp_rect(parameters, "Latewarp.Backbuffer", backbuffer, src);
+    latewarp_rect(parameters, "Latewarp.Output", output, dst);
+    UINT w = std::min(src.right - src.left, dst.right - dst.left), h = std::min(src.bottom - src.top, dst.bottom - dst.top);
+    src.right = src.left + w;
+    src.bottom = src.top + h;
+    if (w && h)
+      context->CopySubresourceRegion(output, 0, dst.left, dst.top, 0, backbuffer, 0, &src);
+    lw->copies++;
+  } else if (!output) {
+    lw->no_output++;
+  }
+
+  if (f && lw->evaluations % 300 == 0) {
+    fprintf(f,
+            "stats @%llu: camera rotation rendered->late avg %.3f deg max %.3f deg (n=%u), not-rendered frames %u, "
+            "pass-through copies %u, no output %u\n",
+            (unsigned long long)lw->evaluations, lw->angle_n ? lw->angle_sum / lw->angle_n : -1.0, lw->angle_max,
+            lw->angle_n, lw->not_rendered, lw->copies, lw->no_output);
+    fflush(f);
+    lw->angle_sum = lw->angle_max = 0;
+    lw->angle_n = lw->not_rendered = lw->copies = lw->no_output = 0;
+  }
+  return NVNGX_RESULT_OK;
+}

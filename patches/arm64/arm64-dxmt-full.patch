+/* deadlock-gptk: --parkour stopwatch overlay. winemac (WINE_MAC_PARKOUR) renders it off the main thread and keeps
+ * it behind macdrv_parkour_overlay_lock/unlock; here a new version is copied into the presenter's texture. The scale
+ * is the drawable's pixels per layer point, so the text has the same size as the game's UI. */
+typedef int (*parkour_overlay_lock_t)(double scale, uint64_t *version, const void **pixels, uint32_t *width,
+                                      uint32_t *height, uint32_t *stride);
+static NTSTATUS
+_WMTParkourOverlay(void *obj) {
+  struct unixcall_parkour_overlay *params = obj;
+  static parkour_overlay_lock_t lock_fn;
+  static void (*unlock_fn)(void);
+  static int looked_up;
+  CAMetalLayer *layer = (CAMetalLayer *)params->layer;
+  id<MTLTexture> texture = (id<MTLTexture>)params->texture;
+  uint64_t version;
+  const void *pixels;
+  uint32_t width, height, stride;
+  double scale;
+
+  if (!looked_up) {
+    lock_fn = (parkour_overlay_lock_t)dlsym(RTLD_DEFAULT, "macdrv_parkour_overlay_lock");
+    unlock_fn = (void (*)(void))dlsym(RTLD_DEFAULT, "macdrv_parkour_overlay_unlock");
+    looked_up = 1;
+  }
+  params->ret = params->have;
+  if (!lock_fn || !unlock_fn || !layer || !texture)
+    return STATUS_SUCCESS;
+  scale = layer.bounds.size.width > 0 ? layer.drawableSize.width / layer.bounds.size.width : 1.0;
+  if (!lock_fn(scale, &version, &pixels, &width, &height, &stride))
+    return STATUS_SUCCESS;
+  if (version != params->have) {
+    width = MIN(width, (uint32_t)texture.width);
+    height = MIN(height, (uint32_t)texture.height);
+    if (width && height && pixels)
+      [texture replaceRegion:MTLRegionMake2D(0, 0, width, height) mipmapLevel:0 withBytes:pixels bytesPerRow:stride];
+    params->width = width;
+    params->height = height;
+    params->ret = version;
+  }
+  unlock_fn();
+  return STATUS_SUCCESS;
+}

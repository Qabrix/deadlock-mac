+++ b/src/dxmt/dxmt_gpu_profile.hpp
@@ -0,0 +1,55 @@
+#pragma once
+#include "Metal.hpp"
+#include <cstdint>
+#include <vector>
+
+namespace dxmt {
+
+/* deadlock-gptk GPU profiler: DXMT_GPU_PROFILE=<windows path> timestamps every render/compute/blit pass, the
+ * MetalFX upscale and the present pass (Metal counter sample buffers at stage boundaries) and appends, every
+ * 5 s, GPU ms per frame by pass kind plus the most expensive pass shapes (kind, size, attachments, draws), and
+ * an estimate of the attachment memory traffic (MB/frame, uncompressed: loads + stores of colour/depth/stencil
+ * over the render area) to compare with the DRAM counters (tools/thermlog.c). */
+bool gpu_profile_enabled();
+
+enum class GpuProfileKind : uint8_t { Render, Compute, Blit, Clear, Resolve, MetalFX, Present, Snapshot, Count };
+
+struct GpuProfileEntry {
+  GpuProfileKind kind;
+  uint8_t colors;  // render: color attachments
+  uint8_t depth;   // render: 1 = has a depth attachment
+  uint8_t pad;
+  uint32_t width;
+  uint32_t height;
+  uint32_t format; // render: first color format (depth format for depth-only passes)
+  uint32_t draws;  // render: draw commands
+  uint32_t kb;     // estimated attachment traffic (KiB, uncompressed): loads + stores over the render area
+};
+
+class GpuProfileChunk {
+public:
+  static constexpr uint32_t kMaxEntries = 2048;
+
+  // reserves the sample pair of one pass; false when full or unavailable
+  bool reserve(WMT::Device device, const GpuProfileEntry &entry, uint32_t &start, uint32_t &end);
+
+  WMT::CounterSampleBuffer
+  buffer() {
+    return sbuf_;
+  }
+
+  // after the command buffer completed (finish thread)
+  void collect(uint64_t frame, WMT::CommandBuffer cmdbuf);
+
+  void
+  reset() {
+    entries_.clear();
+  }
+
+private:
+  WMT::Reference<WMT::CounterSampleBuffer> sbuf_;
+  std::vector<GpuProfileEntry> entries_;
+  bool failed_ = false;
+};
+
+} // namespace dxmt

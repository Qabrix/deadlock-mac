+/* deadlock-gptk: NvAPI_D3D11_CreateDevice. With NvAPI initialised, Deadlock's DX11 renderer creates its device
+ * through this and disables NvAPI (and Reflex) when it fails. Forward to D3D11CreateDevice and report the NVIDIA
+ * extension level for the device's feature level. */
+typedef enum {
+  DL_NVAPI_DEVICE_FEATURE_LEVEL_NULL = -1,
+  DL_NVAPI_DEVICE_FEATURE_LEVEL_10_0 = 0,
+  DL_NVAPI_DEVICE_FEATURE_LEVEL_10_0_PLUS = 1,
+  DL_NVAPI_DEVICE_FEATURE_LEVEL_10_1 = 2,
+  DL_NVAPI_DEVICE_FEATURE_LEVEL_11_0 = 3,
+} DL_NVAPI_DEVICE_FEATURE_LEVEL;
+
+NVAPI_INTERFACE
+NvAPI_D3D11_CreateDevice(IDXGIAdapter *pAdapter, D3D_DRIVER_TYPE DriverType, HMODULE Software, UINT Flags,
+                         const D3D_FEATURE_LEVEL *pFeatureLevels, UINT FeatureLevels, UINT SDKVersion,
+                         ID3D11Device **ppDevice, D3D_FEATURE_LEVEL *pFeatureLevel,
+                         ID3D11DeviceContext **ppImmediateContext, DL_NVAPI_DEVICE_FEATURE_LEVEL *pSupportedLevel) {
+  static auto create = (PFN_D3D11_CREATE_DEVICE)GetProcAddress(LoadLibraryA("d3d11.dll"), "D3D11CreateDevice");
+  if (!create)
+    return NVAPI_ERROR;
+  D3D_FEATURE_LEVEL level = (D3D_FEATURE_LEVEL)0;
+  HRESULT hr = create(pAdapter, DriverType, Software, Flags, pFeatureLevels, FeatureLevels, SDKVersion, ppDevice,
+                      &level, ppImmediateContext);
+  if (pFeatureLevel)
+    *pFeatureLevel = level;
+  if (FAILED(hr))
+    return NVAPI_ERROR;
+  if (pSupportedLevel)
+    *pSupportedLevel = level >= D3D_FEATURE_LEVEL_11_0   ? DL_NVAPI_DEVICE_FEATURE_LEVEL_11_0
+                       : level >= D3D_FEATURE_LEVEL_10_1 ? DL_NVAPI_DEVICE_FEATURE_LEVEL_10_1
+                       : level >= D3D_FEATURE_LEVEL_10_0 ? DL_NVAPI_DEVICE_FEATURE_LEVEL_10_0
+                                                         : DL_NVAPI_DEVICE_FEATURE_LEVEL_NULL;
+  if (FILE *log = nvapi_log_file()) {
+    fprintf(log, "NvAPI_D3D11_CreateDevice -> hr=0x%08lx featureLevel=0x%x\n", (unsigned long)hr, (unsigned)level);
+    fflush(log);
+  }
+  return NVAPI_OK;
+}

+[[kernel]] void present_cas(
+    texture2d<float, access::read> src [[texture(0)]],
+    texture2d<float, access::read> fin [[texture(1)]],
+    texture2d<float, access::write> out [[texture(2)]],
+    constant float4 &params [[buffer(0)]],
+    uint2 pos [[thread_position_in_grid]]
+) {
+  int w = int(out.get_width()), h = int(out.get_height());
+  if (int(pos.x) >= w || int(pos.y) >= h)
+    return;
+  bool decode = params.z > 0.5;
+  float4 f = fin.read(pos);
+  float3 fl = decode ? cas_decode(f.rgb) : f.rgb;
+  float3 e = src.read(pos).rgb;
+  if (params.y >= 0.0) {
+    float3 d = abs(fl - e);
+    float m = d.x > d.y ? d.x : d.y;
+    m = m > d.z ? m : d.z;
+    if (m > params.y) { /* UI pixel: unchanged */
+      out.write(f, pos);
+      return;
+    }
+  }
+  int2 p = int2(pos);
+  int2 pu = int2(p.x, p.y > 0 ? p.y - 1 : 0), pd = int2(p.x, p.y < h - 1 ? p.y + 1 : h - 1);
+  int2 pl = int2(p.x > 0 ? p.x - 1 : 0, p.y), pr = int2(p.x < w - 1 ? p.x + 1 : w - 1, p.y);
+  float3 b = src.read(uint2(pu)).rgb, d = src.read(uint2(pl)).rgb, ff = src.read(uint2(pr)).rgb, hh = src.read(uint2(pd)).rgb;
+  float3 mn = cas_min3(cas_min3(cas_min3(b, d), cas_min3(ff, hh)), e);
+  float3 mx = cas_max3(cas_max3(cas_max3(b, d), cas_max3(ff, hh)), e);
+  float3 inv_mx = 1.0 / (mx + 1e-5);
+  float3 amp = sqrt(clamp(cas_min3(mn, 1.0 - mx) * inv_mx, 0.0, 1.0));
+  float peak = -1.0 / (8.0 - 3.0 * clamp(params.x, 0.0, 1.0));
+  float3 wgt = amp * peak;
+  float3 r = clamp((b + d + ff + hh) * wgt + e, 0.0, 1.0) / (1.0 + 4.0 * wgt);
+  r = clamp(r, 0.0, 1.0);
+  out.write(float4(decode ? cas_encode(r) : r, f.a), pos);
+}

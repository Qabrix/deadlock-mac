diff --git a/src/dxmt/dxmt_residency_set.cpp b/src/dxmt/dxmt_residency_set.cpp
new file mode 100644
index 0000000..bbedba3
--- /dev/null
+++ b/src/dxmt/dxmt_residency_set.cpp
@@ -0,0 +1,95 @@
+#include "dxmt_residency_set.hpp"
+#include "log/log.hpp"
+#include "thread.hpp"
+#include "util_env.hpp"
+#include <mutex>
+#include <vector>
+
+namespace dxmt {
+
+std::atomic<uint64_t> g_residency_set_adds{0}, g_residency_set_removes{0}, g_residency_set_commits{0};
+
+namespace {
+
+dxmt::mutex rs_mutex;
+WMT::Reference<WMT::ResidencySet> rs_set;
+bool rs_failed = false;
+std::atomic<bool> rs_dirty{false};
+// MTLResidencySet doesn't document retaining its allocations: keep removed ones alive until committed.
+std::vector<WMT::Reference<WMT::Allocation>> rs_removed;
+
+bool
+ensure_set(WMT::Device device) {
+  if (rs_set != nullptr)
+    return true;
+  if (rs_failed)
+    return false;
+  WMT::Reference<WMT::Error> err;
+  rs_set = device.newResidencySet(4096, err);
+  if (rs_set == nullptr) {
+    rs_failed = true;
+    ERR("residency set: creation failed: ", err.description().getUTF8String());
+    return false;
+  }
+  WARN("residency set: enabled (no per-encoder useResource for registered allocations)");
+  return true;
+}
+
+} // namespace
+
+bool
+residency_set_enabled() {
+  static bool on = env::getEnvVar("DXMT_RESIDENCY_SET") == "1";
+  return on;
+}
+
+bool
+residency_set_add(WMT::Device device, WMT::Allocation allocation) {
+  if (!residency_set_enabled() || allocation == nullptr)
+    return false;
+  std::unique_lock<dxmt::mutex> lock(rs_mutex);
+  if (!ensure_set(device))
+    return false;
+  rs_set.addAllocations(&allocation, 1);
+  rs_dirty.store(true, std::memory_order_release);
+  g_residency_set_adds.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+
+void
+residency_set_remove(WMT::Allocation allocation) {
+  if (allocation == nullptr)
+    return;
+  std::unique_lock<dxmt::mutex> lock(rs_mutex);
+  if (rs_set == nullptr)
+    return;
+  rs_set.removeAllocations(&allocation, 1);
+  rs_removed.emplace_back(allocation);
+  rs_dirty.store(true, std::memory_order_release);
+  g_residency_set_removes.fetch_add(1, std::memory_order_relaxed);
+}
+
+void
+residency_set_attach(WMT::Device device, WMT::CommandQueue queue) {
+  if (!residency_set_enabled())
+    return;
+  std::unique_lock<dxmt::mutex> lock(rs_mutex);
+  if (ensure_set(device))
+    queue.addResidencySet(rs_set);
+}
+
+void
+residency_set_commit() {
+  if (!rs_dirty.load(std::memory_order_acquire))
+    return;
+  std::vector<WMT::Reference<WMT::Allocation>> released;
+  {
+    std::unique_lock<dxmt::mutex> lock(rs_mutex);
+    rs_dirty.store(false, std::memory_order_relaxed);
+    rs_set.commit();
+    released.swap(rs_removed);
+  }
+  g_residency_set_commits.fetch_add(1, std::memory_order_relaxed);
+}
+
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_residency_set.hpp b/src/dxmt/dxmt_residency_set.hpp
new file mode 100644
index 0000000..68ed166
--- /dev/null
+++ b/src/dxmt/dxmt_residency_set.hpp
@@ -0,0 +1,22 @@
+#pragma once
+#include "Metal.hpp"
+#include <atomic>
+#include <cstdint>
+
+namespace dxmt {
+
+/* deadlock-gptk: DXMT_RESIDENCY_SET=1 keeps every non-heap D3D11 allocation in one process-wide
+ * MTLResidencySet attached to the command queue (like DXMT's D3D12 path), so argument-buffer access no
+ * longer needs a useResource per resource per encoder. Views are covered by their parent allocation. */
+bool residency_set_enabled();
+// Adds `allocation` (uncommitted until residency_set_commit). False when disabled or unavailable.
+bool residency_set_add(WMT::Device device, WMT::Allocation allocation);
+// Removes `allocation`; it stays retained until the removal is committed.
+void residency_set_remove(WMT::Allocation allocation);
+void residency_set_attach(WMT::Device device, WMT::CommandQueue queue);
+// Applies pending adds/removes; called before each command buffer commit.
+void residency_set_commit();
+
+extern std::atomic<uint64_t> g_residency_set_adds, g_residency_set_removes, g_residency_set_commits;
+
+} // namespace dxmt

+      s.dg_fallback++;
+    }
+    render_target = render_free - (s.sim_time + 2 * s.sim_dev) + s.handoff_extra;
+    target = std::max(target, render_target);
+  }
+  /* GPU: free when the previous frame has finished there; this frame's commit comes its simulation plus render
+   * start -> commit after its start (when the render thread waits for nothing) */
+  if (s.ext && s.gpu_busy && (s.commit_from_render || s.to_commit)) {
+    double commit = 0, done = 0, gpu_free;
+    if (p->seq && reflex_timing(s, p->seq, commit, done) && done) {
+      gpu_free = done;
+      s.dg_gpu_done++;
+    } else {
+      double p_commit = (p->seq && commit)                         ? commit
+                        : (p_render_start && s.commit_from_render) ? p_render_start + s.commit_from_render
+                                                                   : start + s.to_commit;
+      /* the frame before p: p's own seq - 1, or the newest seq tied to a frame (p isn't presented yet, so that one

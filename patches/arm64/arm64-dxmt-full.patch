+    s.dg_render_lead += render_target - (double)now;
+    s.dg_render_n++;
+  }
+  if (gpu_target) {
+    s.dg_gpu_lead += gpu_target - (double)now;
+    s.dg_gpu_n++;
+  }
+  /* anti wind-up: the margin never exceeds the (averaged) sleep it trims */
+  s.raw_sleep = ema(s.raw_sleep, std::max(0.0, target - kMarginUs - (double)now), 0.1);
+  s.bias = std::min(s.bias, s.raw_sleep);
+  double sleep = (target - kMarginUs - s.bias - (double)now) * s.scale;
+  return std::clamp(sleep, 0.0, std::min(15000.0, 0.6 * (s.free_interval ? s.free_interval : s.interval)));

+/* deadlock-gptk: NVIDIA Reflex without an NVIDIA driver, scheduled from real pipeline timing.
+ * - SetSleepMode records the game's request (low latency on/off, frame cap minimumIntervalUs). Deadlock re-sends it
+ *   every frame, so only changes are applied/logged; the cap cadence restarts only when the interval changes.
+ * - SetLatencyMarker timestamps the game's markers (steady_clock us, same clock as DXMT's frame timing). At
+ *   PRESENT_END the frame is tied to DXMT's frame seq; once DXMT reports it GPU-complete (IMTLD3D11DeviceExt::
+ *   GetFrameTimingDL: Metal commit + GPU completion time per frame) its waits are measured: GPU queue (previous frame
+ *   still on the GPU when this one was committed) and, if the game submits on its own render thread, the main ->
+ *   render handoff (RENDERSUBMIT_START after SIMULATION_END). Running averages: frame start -> render submit, ->
+ *   present end, -> Metal commit, and GPU busy time.
+ * - Sleep() (frame start, before input is read) predicts when the render thread and the GPU will be free of the
+ *   previous frame and starts this frame so that it reaches them just then (0.5 ms margin): the waits move in front
+ *   of the input sample, input is fresher, and the pipeline stays full (Reflex's scheduling). Split sim/render
+ *   threads (Deadlock): starvation control - when a slept frame left the render thread idle waiting for its
+ *   simulation, the sleep was too long; a quarter of that idle is added as margin (bias), 30 us given back per
+ *   frame, on top of a margin of twice the simulation time's mean deviation. No fps
+ *   comparison (in fights the fps moves on its own, which made the old guard drop the sleep exactly when the
+ *   latency was highest). Same-thread games: a guard keeps the frame rate within DXMT_REFLEX_FPS_LOSS percent
+ *   (default 3) of the rate measured without sleep (10 frames every 600). DXMT_REFLEX_ADAPTIVE=0: no pre-input sleep.
+ * - Frame cap: the game's minimumIntervalUs (1000 = uncapped) or DXMT_REFLEX_FPS=N (fixed pre-input cap), whichever
+ *   is lower in fps. The schedule keeps running on top: the cap is the floor, the scheduled sleep only adds slack.
+ * - GetLatency fills the game's Reflex stats from the markers plus DXMT's commit/GPU times.
+ * Waits use WMTSleepPrecise (kqueue NOTE_CRITICAL; mingw's sleep_until rounds to whole ms) plus a short spin. With
+ * DXMT_NVAPI_LOG set: a "Reflex ..." summary every ~5 s. */
+static FILE *nvapi_log_file();
+Com<IMTLD3D11DeviceExt> GetD3D11DeviceExt(IUnknown *pDevice);
+namespace {
+constexpr unsigned kReflexMarkers = 13; /* SIMULATION_START .. OUT_OF_BAND_PRESENT_END */
+constexpr unsigned kProbePeriod = 600, kProbeFrames = 10, kWarmupFrames = 30;
+constexpr double kMarginUs = 500, kPauseUs = 100000;
+/* handoff feedback: wait left at the handoff as a cushion, us, and the integration gain per frame */
+constexpr double kHandoffKeepUs = 500, kHandoffGain = 0.05;
+struct ReflexFrame {
+  NvU64 frameID;
+  NvU64 t[kReflexMarkers]; /* steady_clock us per NV_LATENCY_MARKER_TYPE, 0 = not seen */
+  NvU64 seq;               /* DXMT frame seq, 0 = not presented yet */
+  NvU64 commit_us, done_us, gpu_start_us;
+  double sleep_us; /* scheduled pre-input sleep before this frame */
+  bool cap_bound;  /* its start waited for the frame cap */
+  bool processed;
+};
+struct ReflexState {
+  std::mutex m;
+  bool low_latency = false, boost = false;
+  uint32_t game_interval_us = 0;
+  std::chrono::steady_clock::time_point next; /* earliest allowed next frame start (frame cap) */
+  bool have_next = false;
+  ReflexFrame frames[64] = {};
+  Com<IMTLD3D11DeviceExt> ext;
+  bool ext_tried = false;
+  DWORD sim_tid = 0, render_tid = 0;
+  NvU64 last_sim_frame = 0, last_present_end = 0;
+  /* running averages, us */
+  double to_render = 0, to_present = 0, to_commit = 0, gpu_busy = 0, interval = 0, sim_time = 0, sim_dev = 0;
+  /* render thread's own time per frame (RENDERSUBMIT_START -> PRESENT_END) and render start -> Metal commit: the
+   * schedule predicts from these, since start -> present / start -> commit contain the very handoff wait the
+   * sleep removes (a slow, circular estimate that overshot and wound the bias up) */
+  double render_time = 0, commit_from_render = 0, raw_sleep = 0;
+  NvU64 last_seq = 0; /* newest DXMT frame seq tied to a Reflex frame */
+  unsigned samples = 0;
+  /* starvation control (split sim/render threads): extra margin, us, grown when a slept frame left the render
+   * thread idle waiting for the simulation, slowly given back otherwise */
+  double bias = 0, pending_sleep = 0;
+  /* handoff feedback (split threads): sleep added before input while the simulation keeps waiting for the render
+   * thread at its handoff (SIMULATION_END -> RENDERSUBMIT_START), us; that wait comes after the input sample, so
+   * moving it before lowers input -> present at the same frame rate (arm64 2026-10-26: 3.1 ms wait, Rosetta 1.5) */
+  double handoff_extra = 0;
+  bool pending_cap_bound = false;
+  unsigned log_starved = 0;
+  double log_cap_wait = 0;
+  /* guard (same-thread games only) */
+  double free_interval = 0, probe_sum = 0, scale = 1;
+  unsigned probe_n = 0, frames_since_probe = 0;
+  bool probing = true;
+  /* periodic log */
+  NvU64 log_t0 = 0;
+  unsigned log_frames = 0, log_done = 0, log_rw_n = 0, log_in_n = 0;
+  double log_sleep = 0, log_interval = 0, log_queue = 0, log_rw = 0, log_busy = 0, log_commit = 0, log_e2e = 0,
+         log_in_present = 0;
+  /* schedule diagnostics per log period: calls, which source p's render start came from (p presented / its
+   * RENDERSUBMIT_START / estimated / start->present fallback), which limit set the target (render thread / GPU /
+   * none), and each limit's lead over now, us */
+  unsigned dg_calls = 0, dg_presented = 0, dg_rs = 0, dg_est = 0, dg_fallback = 0, dg_render_won = 0, dg_gpu_won = 0,
+           dg_none = 0, dg_gpu_done = 0, dg_render_n = 0, dg_gpu_n = 0;
+  double dg_render_lead = 0, dg_gpu_lead = 0;
+};
+ReflexState &reflex_state() {
+  static ReflexState s;
+  return s;
+}
+
+NvU64 reflex_now_us() {
+  return (NvU64)std::chrono::duration_cast<std::chrono::microseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+double reflex_env(const char *name, double fallback) {
+  char v[32];
+  DWORD n = GetEnvironmentVariableA(name, v, sizeof(v));
+  if (!n || n >= sizeof(v))
+    return fallback;
+  return atof(v);
+}
+
+bool reflex_adaptive() {
+  static bool on = reflex_env("DXMT_REFLEX_ADAPTIVE", 1) != 0;
+  return on;
+}
+
+/* DXMT_REFLEX_HANDOFF=0: no handoff feedback (the schedule as of 2026-10-24) */
+bool reflex_handoff() {
+  static bool on = reflex_env("DXMT_REFLEX_HANDOFF", 1) != 0;
+  return on;
+}
+
+uint32_t reflex_user_interval_us() {
+  static uint32_t us = [] {
+    double fps = reflex_env("DXMT_REFLEX_FPS", 0);
+    return fps >= 1 ? (uint32_t)(1e6 / fps) : 0u;
+  }();
+  return us;
+}
+
+double reflex_allowed_loss() {
+  static double loss = std::clamp(reflex_env("DXMT_REFLEX_FPS_LOSS", 3), 0.0, 50.0) / 100;
+  return loss;
+}
+
+/* with s.m held */
+uint32_t reflex_cap_interval_us(ReflexState &s) {
+  return std::max(s.game_interval_us > 1000 ? s.game_interval_us : 0u, reflex_user_interval_us());
+}
+
+double ema(double avg, double sample, double a) { return avg ? (1 - a) * avg + a * sample : sample; }
+
+/* WMTSleepPrecise (kqueue NOTE_CRITICAL, ~30 us late) instead of NtDelayExecution: Wine's select() gets ~25%
+ * macOS timer leeway (a 6 ms sleep wakes 1.5 ms late), which made paced frames start late and the cap drift
+ * below 60. DXMT_REFLEX_OLD_SLEEP=1: NtDelayExecution + 250 us spin (old behavior, for comparison). */
+void reflex_wait_until(std::chrono::steady_clock::time_point tp) {
+  using clock = std::chrono::steady_clock;
+  typedef LONG(WINAPI * NtDelayExecution_t)(BOOLEAN, PLARGE_INTEGER);
+  static bool old_sleep = reflex_env("DXMT_REFLEX_OLD_SLEEP", 0) != 0;
+  static auto delay = (NtDelayExecution_t)GetProcAddress(GetModuleHandleA("ntdll.dll"), "NtDelayExecution");
+  auto spin_margin = std::chrono::microseconds(old_sleep ? 250 : 80);
+  auto now = clock::now();
+  if (tp - now > spin_margin) {
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(tp - now - spin_margin).count();
+    if (!old_sleep) {
+      WMTSleepPrecise((uint64_t)ns);
+    } else if (delay) {
+      LARGE_INTEGER li;
+      li.QuadPart = -(LONGLONG)(ns / 100);
+      delay(FALSE, &li);
+    }
+  }
+  while (clock::now() < tp) { /* the last sliver */ }
+}
+
+ReflexFrame &reflex_frame(ReflexState &s, NvU64 id) {
+  ReflexFrame &f = s.frames[id % 64];
+  if (f.frameID != id) {
+    memset(&f, 0, sizeof(f));
+    f.frameID = id;
+  }
+  return f;
+}
+
+ReflexFrame *reflex_find(ReflexState &s, NvU64 id) {
+  ReflexFrame &f = s.frames[id % 64];
+  return (id && f.frameID == id) ? &f : nullptr;
+}
+
+/* with s.m held: DXMT timing of frame seq, us (0 = unknown) */
+bool reflex_timing(ReflexState &s, NvU64 seq, double &commit, double &done) {
+  commit = done = 0;
+  if (!s.ext || !seq)
+    return false;
+  INT64 c = 0, d = 0;
+  if (!s.ext->GetFrameTimingDL(seq, nullptr, nullptr, &c, &d))
+    return false;
+  commit = c / 1000.0;
+  done = d / 1000.0;
+  return c != 0;
+}
+
+/* with s.m held: measure every presented frame the GPU has finished */
+void reflex_process_completed(ReflexState &s) {
+  if (!s.ext)
+    return;
+  UINT64 completed = 0;
+  s.ext->GetFrameTimingDL(0, nullptr, &completed, nullptr, nullptr);
+  bool split = s.sim_tid && s.render_tid && s.sim_tid != s.render_tid;
+  for (auto &f : s.frames) {
+    if (!f.seq || f.processed || f.seq > completed)
+      continue;
+    f.processed = true;
+    double commit, done, prev_commit, prev_done;
+    if (!reflex_timing(s, f.seq, commit, done) || !done)
+      continue;
+    reflex_timing(s, f.seq - 1, prev_commit, prev_done);
+    double gpu_start = std::max(commit, prev_done);
+    double queue = std::max(0.0, prev_done - commit), busy = done - gpu_start;
+    if (busy < 0 || busy > kPauseUs || queue > kPauseUs)
+      continue;
+    f.commit_us = (NvU64)commit;
+    f.done_us = (NvU64)done;
+    f.gpu_start_us = (NvU64)gpu_start;
+    double start = (double)f.t[SIMULATION_START];
+    if (!start)
+      continue;
+    constexpr double a = 0.1;
+    if (commit > start && commit - start < kPauseUs)
+      s.to_commit = ema(s.to_commit, commit - start, a);
+    if (f.t[PRESENT_END] > start && f.t[PRESENT_END] - start < kPauseUs)
+      s.to_present = ema(s.to_present, f.t[PRESENT_END] - start, a);
+    if (f.t[RENDERSUBMIT_START] > start && f.t[RENDERSUBMIT_START] - start < kPauseUs)
+      s.to_render = ema(s.to_render, f.t[RENDERSUBMIT_START] - start, a);
+    if (f.t[RENDERSUBMIT_START] && commit > f.t[RENDERSUBMIT_START] && commit - f.t[RENDERSUBMIT_START] < kPauseUs)
+      s.commit_from_render = ema(s.commit_from_render, commit - f.t[RENDERSUBMIT_START], a);
+    if (f.t[SIMULATION_END] > start && f.t[SIMULATION_END] - start < kPauseUs) {
+      double sim = double(f.t[SIMULATION_END] - start);
+      if (s.sim_time)
+        s.sim_dev = ema(s.sim_dev, std::abs(sim - s.sim_time), a);
+      s.sim_time = ema(s.sim_time, sim, a);
+    }
+    s.gpu_busy = ema(s.gpu_busy, busy, a);
+    s.samples++;
+    /* log */
+    s.log_done++;
+    s.log_queue += queue;
+    s.log_busy += busy;
+    s.log_commit += commit - start;
+    double input = f.t[INPUT_SAMPLE] ? (double)f.t[INPUT_SAMPLE] : start;
+    s.log_e2e += done - input;
+    if (split && f.t[RENDERSUBMIT_START] && f.t[SIMULATION_END] && f.t[RENDERSUBMIT_START] > f.t[SIMULATION_END]) {
+      s.log_rw += double(f.t[RENDERSUBMIT_START] - f.t[SIMULATION_END]);
+      s.log_rw_n++;
+    }
+    /* integrate the handoff wait towards kHandoffKeepUs: grows while the simulation waits, shrinks when the sleep
+     * made it reach the handoff late (the render thread starved, which the bias handles too) */
+    if (split && reflex_handoff() && f.t[RENDERSUBMIT_START] && f.t[SIMULATION_END]) {
+      double wait = std::max(0.0, double(f.t[RENDERSUBMIT_START]) - double(f.t[SIMULATION_END]));
+      s.handoff_extra = std::clamp(s.handoff_extra + kHandoffGain * (wait - kHandoffKeepUs), 0.0, 0.4 * s.interval);
+    }
+  }
+}
+
+/* with s.m held, at PRESENT_END of frame f */
+void reflex_update(ReflexState &s, ReflexFrame &f, NvU64 now) {
+  if (s.ext) {
+    UINT64 presented = 0;
+    s.ext->GetFrameTimingDL(0, &presented, nullptr, nullptr, nullptr);
+    /* an occluded or test Present doesn't reach DXMT's PresentBoundary: don't tie this frame to the previous seq */
+    f.seq = presented != s.last_seq ? presented : 0;
+    if (f.seq)
+      s.last_seq = presented;
+  }
+  if (f.t[RENDERSUBMIT_START] && now > f.t[RENDERSUBMIT_START] && now - f.t[RENDERSUBMIT_START] < kPauseUs)
+    s.render_time = ema(s.render_time, double(now - f.t[RENDERSUBMIT_START]), 0.1);
+  reflex_process_completed(s);
+
+  double interval = (s.last_present_end && now > s.last_present_end) ? double(now - s.last_present_end) : 0;
+  NvU64 prev_present_end = s.last_present_end;
+  s.last_present_end = now;
+  bool split = s.sim_tid && s.render_tid && s.sim_tid != s.render_tid;
+  if (split && prev_present_end && f.t[RENDERSUBMIT_START] && f.t[SIMULATION_END]) {
+    /* the render thread was free (previous present done) but this frame's submit only started when its simulation
+     * ended: it waited for the simulation. If we slept before that simulation (and not for the cap), the sleep
+     * was too long by about the idle time. */
+    double idle = double(f.t[RENDERSUBMIT_START]) - double(prev_present_end);
+    double handoff = double(f.t[RENDERSUBMIT_START]) - double(f.t[SIMULATION_END]);
+    /* a quarter of the idle per event, 30 us back per frame: settles where a few percent of frames start the
+     * render thread slightly late (simulation time varies by itself; blaming each late one fully on the sleep
+     * built up ~7 ms of margin and cancelled the sleep) */
+    if (idle > 250 && idle < kPauseUs && handoff < 150 && f.sleep_us > 0 && !f.cap_bound) {
+      s.bias = std::min(10000.0, s.bias + 0.25 * std::min(idle, f.sleep_us));
+      s.log_starved++;
+    } else {
+      s.bias = std::max(0.0, s.bias - 30);
+    }
+  }
+  if (interval <= 0 || interval > kPauseUs)
+    return; /* first frame, or a pause (loading, focus loss) */
+  s.interval = ema(s.interval, interval, 0.1);
+
+  bool adaptive = s.low_latency && reflex_adaptive(); /* also with a cap: the cap is a floor, the schedule adds slack */
+  if (adaptive && split) {
+    s.probing = false; /* starvation control instead of the fps guard */
+    s.scale = 1;
+    s.free_interval = 0; /* a same-thread stretch (menu, loading) must not cap the sleep here */
+  } else if (!adaptive) {
+    s.probing = true;
+    s.probe_n = 0;
+    s.probe_sum = 0;
+  } else if (s.probing) {
+    s.probe_sum += interval; /* no sleep now: the free frame interval */
+    if (++s.probe_n >= kProbeFrames) {
+      s.free_interval = s.probe_sum / s.probe_n;
+      s.probing = false;
+      s.frames_since_probe = 0;
+    }
+  } else {
+    double limit = s.free_interval * (1 + reflex_allowed_loss()) + 200;
+    if (s.interval > limit)
+      s.scale = std::max(0.0, s.scale * 0.8); /* the sleep costs frame rate: back off */
+    else
+      s.scale = std::min(1.0, s.scale + 0.01);
+    if (++s.frames_since_probe >= kProbePeriod) {
+      s.probing = true;
+      s.probe_n = 0;
+      s.probe_sum = 0;
+    }
+  }
+
+  s.log_frames++;
+  s.log_interval += interval;
+  if (f.t[INPUT_SAMPLE] && f.t[PRESENT_END] >= f.t[INPUT_SAMPLE]) {
+    s.log_in_present += double(f.t[PRESENT_END] - f.t[INPUT_SAMPLE]);
+    s.log_in_n++;
+  }
+  if (!s.log_t0)
+    s.log_t0 = now;
+  if (now - s.log_t0 >= 5000000) {
+    if (FILE *log = nvapi_log_file()) {
+      double n = s.log_frames, d = s.log_done;
+      auto avg = [](double sum, double k) { return k ? sum / k / 1000 : -1.0; };
+      fprintf(log,
+              "Reflex lowLatency=%d mode=%s cap=%uus fps=%.1f sleep=%.2fms scale=%.2f interval=%.2fms free=%.2fms "
+              "gpuQueue=%.2fms handoffWait=%.2fms gpuBusy=%.2fms startToCommit=%.2fms input->gpuDone=%.2fms "
+              "input->present=%.2fms capWait=%.2fms bias=%.2fms starved=%u sim=%.2fms simDev=%.2fms threads=%s timing=%s\n",
+              (int)s.low_latency, adaptive ? (reflex_cap_interval_us(s) ? "cap+sched" : "sched") : (reflex_cap_interval_us(s) ? "cap" : "off"),
+              (unsigned)reflex_cap_interval_us(s), n * 1e6 / double(now - s.log_t0), avg(s.log_sleep, n), s.scale,
+              avg(s.log_interval, n), s.free_interval / 1000, avg(s.log_queue, d), avg(s.log_rw, s.log_rw_n),
+              avg(s.log_busy, d), avg(s.log_commit, d), avg(s.log_e2e, d), avg(s.log_in_present, s.log_in_n),
+              avg(s.log_cap_wait, n), s.bias / 1000, s.log_starved, s.sim_time / 1000, s.sim_dev / 1000,
+              (s.sim_tid && s.render_tid) ? (s.sim_tid != s.render_tid ? "split" : "same") : "?",
+              s.ext ? "dxmt" : "none");
+      /* why the sleep is what it is: p's render start source, the limit that set the target and each limit's lead
+       * over now (sleep ~ lead - margin - bias), and the predictors */
+      fprintf(log,
+              "Reflex diag calls=%u renderSrc presented/rs/est/fallback=%u/%u/%u/%u gpuSrc done=%u "
+              "bound render/gpu/none=%u/%u/%u renderLead=%.2fms gpuLead=%.2fms rawSleep=%.2fms renderT=%.2fms "
+              "renderToCommit=%.2fms toPresent=%.2fms toCommit=%.2fms margin=%.2fms handoffExtra=%.2fms\n",
+              s.dg_calls, s.dg_presented, s.dg_rs, s.dg_est, s.dg_fallback, s.dg_gpu_done, s.dg_render_won,
+              s.dg_gpu_won, s.dg_none, avg(s.dg_render_lead, s.dg_render_n), avg(s.dg_gpu_lead, s.dg_gpu_n),
+              s.raw_sleep / 1000, s.render_time / 1000, s.commit_from_render / 1000, s.to_present / 1000,
+              s.to_commit / 1000, kMarginUs / 1000, s.handoff_extra / 1000);
+      fflush(log);
+    }
+    s.log_t0 = now;
+    s.log_frames = s.log_done = s.log_rw_n = s.log_in_n = s.log_starved = 0;
+    s.log_cap_wait = 0;
+    s.dg_calls = s.dg_presented = s.dg_rs = s.dg_est = s.dg_fallback = s.dg_render_won = s.dg_gpu_won = s.dg_none =
+        s.dg_gpu_done = s.dg_render_n = s.dg_gpu_n = 0;
+    s.dg_render_lead = s.dg_gpu_lead = 0;
+    s.log_sleep = s.log_interval = s.log_queue = s.log_rw = s.log_busy = s.log_commit = s.log_e2e = s.log_in_present =
+        0;
+  }
+}
+
+/* with s.m held: sleep before the next frame, us */
+double reflex_schedule(ReflexState &s, NvU64 now) {
+  if (!s.low_latency || !reflex_adaptive() || s.probing || s.samples < kWarmupFrames)
+    return 0;
+  ReflexFrame *p = reflex_find(s, s.last_sim_frame);
+  if (!p || !p->t[SIMULATION_START])
+    return 0;
+  double start = (double)p->t[SIMULATION_START], target = 0;
+
+  /* render thread: free when the previous frame p has been presented; this frame's simulation has to end then.
+   * p's render work starts at its RENDERSUBMIT_START, or - not there yet - when both its simulation and the frame
+   * before it are done; plus the render thread's own time per frame. Subtract this frame's simulation time with a
+   * margin of twice its mean deviation. (Older estimates via start -> present / start -> render submit contained
+   * the handoff wait itself.) */
+  bool split = s.sim_tid && s.render_tid && s.sim_tid != s.render_tid;
+  double p_render_start = 0, render_target = 0, gpu_target = 0;
+  s.dg_calls++;
+  if (split && s.sim_time) {
+    double render_free;
+    if (p->t[PRESENT_END]) {
+      render_free = (double)p->t[PRESENT_END];
+      s.dg_presented++;
+    } else if (s.render_time) {
+      if (p->t[RENDERSUBMIT_START]) {
+        p_render_start = (double)p->t[RENDERSUBMIT_START];
+        s.dg_rs++;
+      } else {
+        s.dg_est++;
+        ReflexFrame *q = reflex_find(s, p->frameID - 1);
+        double prev_end = (q && q->t[PRESENT_END])          ? (double)q->t[PRESENT_END]
+                          : (q && q->t[RENDERSUBMIT_START]) ? (double)q->t[RENDERSUBMIT_START] + s.render_time
+                                                            : (double)s.last_present_end;

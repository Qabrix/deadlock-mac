+  memcpy(&count, p + 28, 4);
+  for (uint32_t i = 0; i < count && 32 + i * 4 + 4 <= BytecodeLength; i++) {
+    uint32_t off;
+    memcpy(&off, p + 32 + i * 4, 4);
+    if (off + 12 > BytecodeLength)
+      continue;

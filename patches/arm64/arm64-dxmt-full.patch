+/* deadlock-gptk: DXMT_DLSS_LOG=<windows path> records what the game hands to DLSS (create flags, texture
+ * sizes/formats, subrect bases, jitter, motion vector scale, reset, exposure) to check the MetalFX
+ * mapping: every evaluate for the first 600 after a create, then every 600th. */
+static FILE *
+dlss_log() {
+  static FILE *f = [] {
+    const char *p = getenv("DXMT_DLSS_LOG");
+    return p && *p ? fopen(p, "a") : (FILE *)nullptr;
+  }();
+  return f;
+}
+static unsigned dlss_log_calls = 0;
+
+static void
+dlss_log_tex(FILE *f, const char *name, ID3D11Resource *r) {
+  D3D11_TEXTURE2D_DESC d = {};
+  if (r)
+    static_cast<ID3D11Texture2D *>(r)->GetDesc(&d);
+  fprintf(f, " %s=%ux%u/f%u/b%x", name, d.Width, d.Height, (unsigned)d.Format, d.BindFlags);
+}
+
+/* deadlock-gptk: Reflex 2 Frame Warp (NGX feature 15), probe stage. DXMT_LATEWARP_LOG=<windows path>: on create,
+ * for the first 3 evaluates and every 600th, every parameter the game set (textures with size/format/bind flags,
+ * matrices as numbers); every 300 evaluates the camera rotation between the camera the frame was rendered with
+ * (PrevRenderedWorldToViewMatrix) and the late one (WorldToViewMatrix), which is what a warp would correct. The frame
+ * is passed through unwarped (Backbuffer -> Output, honouring the subrects). */
+static FILE *
+latewarp_log() {
+  static FILE *f = [] {
+    const char *p = getenv("DXMT_LATEWARP_LOG");
+    return p && *p ? fopen(p, "a") : (FILE *)nullptr;
+  }();
+  return f;
+}

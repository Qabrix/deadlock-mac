+ * setup); a NULL function made the game drop DLSS. The handle is opaque to the caller: the resource pointer itself,
+ * as other open-source NvAPI layers do. */
+NVAPI_INTERFACE
+NvAPI_D3D11_GetResourceHandle(ID3D11Device *pDev, ID3D11Resource *pResource, NVDX_ObjectHandle *phObject) {
+  if (!pDev || !pResource || !phObject)

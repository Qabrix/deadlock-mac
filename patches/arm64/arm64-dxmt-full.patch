+    if (a0.depth_plane != a1.depth_plane) return "color-plane";
+    if (!a0.attachment) continue;
+    if (a0.store_action != WMTStoreActionStore) return "color-not-stored";
+    if (a1.load_action != WMTLoadActionLoad) return "color-not-loaded";
+  }
+  if (r1->fence_wait_vertex.intersectedWith(r0->fence_update)) return "vertex-waits-fragment";
+  return "dependency-between";
+}
+
+static const void *dump_presented = nullptr, *dump_dlss_depth = nullptr;
+
+static std::string
+attachment_desc(const TextureViewRef &att, WMTLoadAction load, WMTStoreAction store) {
+  static const char *loads = "-LC", *stores = "-SRB?";
+  if (!att) return "none";
+  return std::format("{:x}/{}{}{}", ((uintptr_t)att->allocation >> 4) & 0xfffff,
+                     loads[std::min<unsigned>(load, 2)], stores[std::min<unsigned>(store, 4)],
+                     att->allocation == dump_presented ? "[SCREEN]" : att->allocation == dump_dlss_depth ? "[DLSSDEPTH]" : "");
+}
+
+static void
+dump_encoders(EncoderData **encoders, unsigned count, uint64_t frame, uint64_t seq,
+              const std::function<bool(EncoderData *, EncoderData *)> &depends,
+              const std::function<bool(RenderEncoderData *, RenderEncoderData *)> &same_setup) {
+  static const char *names[] = {"null", "render", "compute", "blit", "clear", "resolve", "present",
+                                "spatial", "signal", "temporal", "wait", "timestamp"};
+  Logger::info(std::format("pass-dump frame {} cmdbuf {}: {} encoders", frame, seq, count));
+  RenderEncoderData *prev = nullptr;
+  unsigned between = 0;
+  for (unsigned i = 0; i < count; i++) {
+    auto e = encoders[i];
+    if (e->type == EncoderType::Null) continue;
+    if (e->type == EncoderType::Clear) {
+      /* deadlock-gptk: which target a clear that was not folded into a render pass hits */
+      auto c = static_cast<ClearEncoderData *>(e);
+      Logger::info(std::format("  #{:3} clear {} {}x{} dsv={} discard={} whole={} arr={}", i,
+                               c->attachment ? std::format("{:x}", ((uintptr_t)c->attachment->allocation >> 4) & 0xfffff)
+                                             : std::string("none"),
+                               c->width, c->height, c->clear_dsv, (int)c->discard, (int)c->whole, c->array_length));
+      between++;
+      continue;
+    }
+    if (e->type != EncoderType::Render) {
+      Logger::info(std::format("  #{:3} {}", i, names[(unsigned)e->type]));
+      between++;
+      continue;
+    }
+    auto r = static_cast<RenderEncoderData *>(e);
+    unsigned draws = 0, cmds = 0;
+    double vp_w = 0, vp_h = 0;
+    for (auto c = (wmtcmd_base *)r->cmd_head.next.get(); c; c = (wmtcmd_base *)c->next.get()) {
+      cmds++;
+      if (!vp_w && c->type == WMTRenderCommandSetViewport) {
+        auto v = (wmtcmd_render_setviewport *)c;
+        vp_w = v->viewport.width; vp_h = v->viewport.height;
+      } else if (!vp_w && c->type == WMTRenderCommandSetViewports) {
+        auto v = (wmtcmd_render_setviewports *)c;
+        if (v->viewport_count) {
+          auto vps = (WMTViewport *)v->viewports.get();
+          vp_w = vps[0].width; vp_h = vps[0].height;
+        }
+      }
+      switch (c->type) {
+      case WMTRenderCommandDraw: case WMTRenderCommandDrawIndexed: case WMTRenderCommandDrawIndirect:
+      case WMTRenderCommandDrawIndexedIndirect: case WMTRenderCommandDrawMeshThreadgroups:
+      case WMTRenderCommandDrawMeshThreadgroupsIndirect: case WMTRenderCommandDXMTGeometryDraw:
+      case WMTRenderCommandDXMTGeometryDrawIndexed: case WMTRenderCommandDXMTGeometryDrawIndirect:
+      case WMTRenderCommandDXMTGeometryDrawIndexedIndirect: case WMTRenderCommandDXMTTessellationMeshDraw:
+      case WMTRenderCommandDXMTTessellationMeshDrawIndexed: case WMTRenderCommandDXMTTessellationMeshDrawIndirect:
+      case WMTRenderCommandDXMTTessellationMeshDrawIndexedIndirect:
+        draws++;
+        break;
+      default:
+        break;
+      }
+    }
+    std::string colors;
+    for (unsigned c = 0; c < r->render_target_count; c++)
+      colors += " c" + std::to_string(c) + "=" +
+                attachment_desc(r->colors[c].attachment, r->colors[c].load_action, r->colors[c].store_action);
+    std::string depth = (r->dsv_planar_flags & 1)
+                            ? attachment_desc(r->depth.attachment, r->depth.load_action, r->depth.store_action) +
+                                  ((r->dsv_readonly_flags & 1) ? "(ro)" : "")
+                            : "none";
+    Logger::info(std::format(
+        "  #{:3} render {}x{} vp={}x{} rt={}{} d={} argbuf={:x} draws={} cmds={} | vs prev render: {}{}", i,
+        r->render_target_width, r->render_target_height, (int)vp_w, (int)vp_h, (unsigned)r->render_target_count, colors, depth,
+        ((uintptr_t)r->allocated_argbuf.handle >> 4) & 0xfffff, draws, cmds,
+        prev ? render_merge_blocker(prev, r) : "first", between ? std::format(" (+{} other between)", between) : ""
+    ));
+    /* Nearest earlier pass with a mergeable setup, and the first encoder in between that the
+     * optimizer could not move it past (a data dependency in either direction). */
+    for (unsigned k = i; k-- > 0;) {
+      if (encoders[k]->type != EncoderType::Render) continue;
+      auto r0 = static_cast<RenderEncoderData *>(encoders[k]);
+      if (!same_setup(r0, r)) continue;
+      std::string why = "no blocker found";
+      for (unsigned m = k + 1; m < i; m++) {
+        if (encoders[m]->type == EncoderType::Null) continue;
+        if (depends(encoders[m], r0)) {
+          why = std::format("blocked by #{} {}", m, names[(unsigned)encoders[m]->type]);
+          break;
+        }
+      }
+      if (why == "no blocker found" && r->fence_wait_vertex.intersectedWith(r0->fence_update))
+        why = "vertex waits on its fragment output";
+      Logger::info(std::format("        same setup as #{}: {}", k, why));
+      break;
+    }
+    prev = r;
+    between = 0;
+  }
+}
+
+/* deadlock-gptk: DXMT_FRAMEGEN=debug presents only the MetalFX-interpolated frame (between the
+ * previous and the current one) to check interpolation quality. Camera parameters DLSS does not
+ * pass: DXMT_FRAMEGEN_FOV (vertical, degrees), DXMT_FRAMEGEN_NEAR, DXMT_FRAMEGEN_FAR. */
+static int
+framegen_mode() {
+  static int mode = [] {
+    auto v = env::getEnvVar("DXMT_FRAMEGEN");
+    if (v == "debug") return 2;
+    return v.empty() || v == "0" ? 0 : 1;   /* 1 and "auto" present generated frames */
+  }();
+  return mode;
+}
+
+/* deadlock-gptk: DXMT_SHARPEN=<0..1> sharpens the presented scene (CAS), leaving the UI as is.
+ * DXMT_SHARPEN_FILE (a Windows path) holding a number is re-read twice a second: live strength. */
+static float
+sharpen_strength() {
+  static float s = [] {
+    auto v = env::getEnvVar("DXMT_SHARPEN");
+    return v.empty() ? 0.0f : std::clamp(strtof(v.c_str(), nullptr), 0.0f, 1.0f);
+  }();
+  static const std::string path = env::getEnvVar("DXMT_SHARPEN_FILE");
+  static auto next = std::chrono::steady_clock::now();
+  if (!path.empty()) {
+    auto now = std::chrono::steady_clock::now();
+    if (now >= next) {
+      next = now + std::chrono::milliseconds(500);
+      if (FILE *f = fopen(path.c_str(), "r")) {
+        float v;
+        if (fscanf(f, "%f", &v) == 1)
+          s = std::clamp(v, 0.0f, 1.0f);
+        fclose(f);
+      }
+    }
+  }
+  return s;
+}
+
+/* deadlock-gptk: DXMT_SPATIAL_UPSCALE=1 replaces the game's own upscale of a reduced viewport (Deadlock's
+ * "stretch": scene rendered into the top-left region of full-size targets, then stretched) with
+ * MetalFX Spatial, just before the UI is drawn on top */
+static bool
+spatial_upscale_enabled() {
+  static bool on = env::getEnvVar("DXMT_SPATIAL_UPSCALE") == "1";
+  return on;
+}
+
+static bool
+framegen_auto() {
+  static bool on = env::getEnvVar("DXMT_FRAMEGEN") == "auto";
+  return on;
+}
+
+static std::atomic<float> g_framegen_game_work_ms{0.0f};
+
+void
+framegen_report_game_work(float ms) {
+  /* light smoothing: one slow frame should not flip the mode */
+  float prev = g_framegen_game_work_ms.load(std::memory_order_relaxed);
+  g_framegen_game_work_ms.store(prev ? prev * 0.8f + ms * 0.2f : ms, std::memory_order_relaxed);
+}
+
+static bool
+is_srgb(WMTPixelFormat format) {
+  switch (format) {
+  case WMTPixelFormatRGBA8Unorm_sRGB:
+  case WMTPixelFormatBGRA8Unorm_sRGB:
+    return true;
+  default:
+    return false;
+  }
+}
+
+/* deadlock-gptk: cached per name. GetEnvironmentVariableW walks Wine's whole environment (Rosetta-translated,
+ * ~8 us); this was called ~40 times a frame (per render pass until the UI snapshot) and showed up as 12-13 % of the
+ * encode thread. The names are string literals and the environment doesn't change during a session. */
+static float
+framegen_param(const char *name, float fallback) {
+  static dxmt::mutex m;
+  static std::unordered_map<std::string, float> cache;
+  std::lock_guard<dxmt::mutex> lock(m);
+  auto it = cache.find(name);
+  if (it != cache.end())
+    return it->second;
+  auto v = env::getEnvVar(name);
+  float r = v.empty() ? fallback : strtof(v.c_str(), nullptr);
+  cache.emplace(name, r);
+  return r;
+}
+
+/* deadlock-gptk: sharpen right after MetalFX (DLSS output, before the game draws its UI) instead of in the present
+ * pass: no UI-free snapshot and no UI test, the UI is never sharpened. DXMT_SHARPEN_AT_UPSCALE=0: the old
+ * present-time path (snapshot + UI threshold). Frame generation and frames without DLSS keep the old path. */
+static bool
+sharpen_at_upscale_enabled() {
+  static bool on = env::getEnvVar("DXMT_SHARPEN_AT_UPSCALE") != "0";
+  return on;
+}
+
+/* The game's UI starts with the first full-output-size pass after DLSS that clears a depth buffer
+ * of its own (Deadlock: Panorama draws into the post-processed scene target with a fresh depth). */
+bool
+ArgumentEncodingContext::fgShouldSnapshot(RenderEncoderData *data) {
+  /* frame generation needs DLSS's depth/motion; sharpening only needs the UI-free scene, so
+   * without DLSS the presented image's size stands in for the DLSS output size */
+  static const bool snapshot_on = framegen_param("DXMT_FRAMEGEN_SNAPSHOT", 1.0f) != 0.0f;
+  if (fg_snapped_ || !snapshot_on)
+    return false;
+  if (!fg_dlss_seen_ && !((sharpen_strength() > 0 || spatial_upscale_enabled()) && fg_present_w_))
+    return false;
+  uint64_t full_w = fg_dlss_seen_ ? fg_dlss_out_w_ : fg_present_w_;
+  uint64_t full_h = fg_dlss_seen_ ? fg_dlss_out_h_ : fg_present_h_;
+  if (data->render_target_count != 1 || !data->colors[0].attachment)
+    return false;
+  if (!(data->dsv_planar_flags & 1) || !data->depth.attachment)
+    return false;
+  const void *color = data->colors[0].attachment->allocation, *depth = data->depth.attachment->allocation;
+  /* rule 2: the target + UI depth pair of an earlier snapshot. On frames that reuse the UI
+   * (panorama_max_fps below the frame rate) the UI depth is loaded instead of cleared. */
+  if (color == fg_ui_color_alloc_ && depth == fg_ui_depth_alloc_)
+    return true;
+  /* rule 1: a full-output-size pass clearing a depth buffer of its own */
+  if (data->depth.load_action != WMTLoadActionClear || depth == fg_dlss_depth_alloc_)
+    return false;
+  if (data->render_target_width != full_w || data->render_target_height != full_h)
+    return false;
+  fg_ui_color_alloc_ = color;
+  fg_ui_depth_alloc_ = depth;
+  return true;
+}
+
+/* deadlock-gptk: DXMT_TRIM_RENDER_AREA=1 - a pass whose draws all stay inside viewports covering
+ * only the top-left part of its targets (Deadlock's "stretch" renders the scene into a reduced
+ * viewport of full-size targets) gets that part, plus a margin and rounded to tiles, as its render
+ * area. The GPU then neither loads, clears nor stores the tiles nothing is drawn into. Passes
+ * without draws (pure clears) and draws before any viewport keep the full area. */
+static bool
+trim_render_area_enabled() {
+  static bool on = env::getEnvVar("DXMT_TRIM_RENDER_AREA") == "1";
+  return on;
+}
+
+/* deadlock-gptk: encoder labels only matter in a GPU capture; each costs an NSString plus two unix calls */
+static bool
+debug_labels_enabled() {
+  static bool on = !env::getEnvVar("MTL_CAPTURE_ENABLED").empty() || env::getEnvVar("DXMT_DEBUG_LABELS") == "1";
+  return on;
+}
+
+std::atomic<uint64_t> g_load_skip_applied{0};
+std::atomic<uint64_t> g_depth_store_skipped{0}, g_ds_veto_srv{0}, g_ds_veto_load{0}, g_ds_veto_other{0};
+std::atomic<uint64_t> g_upscale_sharpened{0}, g_upscale_sharpen_fallback{0};
+
+/* deadlock-gptk: DXMT_DEPTH_STORE_SKIP=1 - a depth-stencil buffer that cannot be sampled (no ShaderRead usage) and
+ * whose every use clears it at load (Deadlock's UI depth: cleared at the start of the UI pass, stored at its end, and
+ * cleared again next frame) never needs its contents written back to memory. After 60 consecutive frames in which
+ * every pass cleared it, its stores become DontCare. The first pass that loads it vetoes the buffer for good (that
+ * one frame would see stale depth). */
+static bool
+depth_store_skip_enabled() {
+  static bool on = env::getEnvVar("DXMT_DEPTH_STORE_SKIP") == "1";
+  return on;
+}
+
+static void
+depth_store_skip(RenderEncoderData *data, WMTRenderPassInfo &info, uint64_t frame) {
+  auto *alloc = data->depth.attachment ? data->depth.attachment->allocation
+                : data->stencil.attachment ? data->stencil.attachment->allocation : nullptr;
+  if (!alloc || alloc->ds_never)
+    return;
+  if (data->stencil.attachment && data->depth.attachment &&
+      data->stencil.attachment->allocation != data->depth.attachment->allocation) {
+    alloc->ds_never = true;
+    g_ds_veto_other.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  /* v2: a buffer the game may sample (SRV bind flag) qualifies until a shader actually binds it */
+  if (!alloc->descriptor || alloc->ds_sampled || alloc->descriptor->sampleCount() > 1) {
+    alloc->ds_never = true;
+    g_ds_veto_srv.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  auto cleared = [](WMTLoadAction a) { return a == WMTLoadActionClear || a == WMTLoadActionDontCare; };
+  bool clears = (!data->depth.attachment || cleared(info.depth.load_action)) &&
+                (!data->stencil.attachment || cleared(info.stencil.load_action));
+  if (!clears) {
+    alloc->ds_never = true;
+    g_ds_veto_load.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  if (alloc->ds_frame != frame) {
+    /* close the previous frame of this buffer: a frame counts only if all its uses cleared */
+    if (alloc->ds_frame != ~0ull)
+      alloc->ds_clear_streak = alloc->ds_frame_all_cleared ? alloc->ds_clear_streak + 1 : 0;
+    alloc->ds_frame = frame;
+    alloc->ds_frame_all_cleared = true;
+  }
+  if (alloc->ds_clear_streak < 60)
+    return;
+  bool skipped = false;
+  if (data->depth.attachment && info.depth.store_action == WMTStoreActionStore) {
+    info.depth.store_action = WMTStoreActionDontCare;
+    skipped = true;
+  }
+  if (data->stencil.attachment && info.stencil.store_action == WMTStoreActionStore) {
+    info.stencil.store_action = WMTStoreActionDontCare;
+    skipped = true;
+  }
+  if (skipped)
+    g_depth_store_skipped.fetch_add(1, std::memory_order_relaxed);
+}
+
+/* deadlock-gptk load skip: true if every viewport set in the pass equals the first one, starts at (0,0),
+ * and is set before the first draw; w/h = its extent rounded up (the area the first draw repaints) */
+static bool
+single_viewport_extent(RenderEncoderData *data, uint32_t &w, uint32_t &h) {
+  bool seen = false;
+  WMTViewport first{};
+  for (auto c = (wmtcmd_base *)data->cmd_head.next.get(); c; c = (wmtcmd_base *)c->next.get()) {
+    const WMTViewport *vps = nullptr;
+    unsigned count = 0;
+    if (c->type == WMTRenderCommandSetViewport) {
+      vps = &((wmtcmd_render_setviewport *)c)->viewport;
+      count = 1;
+    } else if (c->type == WMTRenderCommandSetViewports) {
+      auto v = (wmtcmd_render_setviewports *)c;
+      vps = (const WMTViewport *)v->viewports.get();
+      count = v->viewport_count;
+    } else if (c->type == WMTRenderCommandDraw || c->type == WMTRenderCommandDrawIndexed ||
+               c->type == WMTRenderCommandDrawIndirect || c->type == WMTRenderCommandDrawIndexedIndirect) {
+      if (!seen)
+        return false;
+      continue;
+    } else {
+      continue;
+    }
+    for (unsigned i = 0; i < count; i++) {
+      if (!seen) {
+        first = vps[i];
+        seen = true;
+        if (first.originX != 0 || first.originY != 0 || first.width <= 0 || first.height <= 0)
+          return false;
+      } else if (vps[i].originX != first.originX || vps[i].originY != first.originY ||
+                 vps[i].width != first.width || vps[i].height != first.height) {
+        return false;
+      }
+    }
+  }
+  if (!seen)
+    return false;
+  w = (uint32_t)std::ceil(first.width);
+  h = (uint32_t)std::ceil(first.height);
+  return true;
+}
+
+static bool
+trimmed_render_area(RenderEncoderData *data, uint32_t &w, uint32_t &h) {
+  double max_x = 0, max_y = 0;
+  bool viewport_seen = false, draws = false;
+  for (auto c = (wmtcmd_base *)data->cmd_head.next.get(); c; c = (wmtcmd_base *)c->next.get()) {
+    switch (c->type) {
+    case WMTRenderCommandSetViewport: {
+      auto &v = ((wmtcmd_render_setviewport *)c)->viewport;
+      max_x = std::max(max_x, v.originX + v.width);
+      max_y = std::max(max_y, v.originY + v.height);
+      viewport_seen = true;
+      break;
+    }
+    case WMTRenderCommandSetViewports: {
+      auto v = (wmtcmd_render_setviewports *)c;
+      auto vps = (WMTViewport *)v->viewports.get();
+      for (unsigned i = 0; i < v->viewport_count; i++) {
+        max_x = std::max(max_x, vps[i].originX + vps[i].width);
+        max_y = std::max(max_y, vps[i].originY + vps[i].height);
+      }
+      viewport_seen |= v->viewport_count > 0;
+      break;
+    }
+    case WMTRenderCommandDraw: case WMTRenderCommandDrawIndexed: case WMTRenderCommandDrawIndirect:
+    case WMTRenderCommandDrawIndexedIndirect: case WMTRenderCommandDrawMeshThreadgroups:
+    case WMTRenderCommandDrawMeshThreadgroupsIndirect: case WMTRenderCommandDXMTGeometryDraw:
+    case WMTRenderCommandDXMTGeometryDrawIndexed: case WMTRenderCommandDXMTGeometryDrawIndirect:
+    case WMTRenderCommandDXMTGeometryDrawIndexedIndirect: case WMTRenderCommandDXMTTessellationMeshDraw:
+    case WMTRenderCommandDXMTTessellationMeshDrawIndexed: case WMTRenderCommandDXMTTessellationMeshDrawIndirect:
+    case WMTRenderCommandDXMTTessellationMeshDrawIndexedIndirect:
+      if (!viewport_seen)
+        return false;
+      draws = true;
+      break;
+    default:
+      break;
+    }
+  }
+  if (!draws || max_x <= 0 || max_y <= 0)
+    return false;
+  /* 16 px margin (bilinear reads at the viewport edge), rounded up to 32 px tiles */
+  uint32_t tw = std::min<uint32_t>(data->render_target_width, ((uint32_t)std::ceil(max_x) + 16 + 31) & ~31u);
+  uint32_t th = std::min<uint32_t>(data->render_target_height, ((uint32_t)std::ceil(max_y) + 16 + 31) & ~31u);
+  if (tw >= data->render_target_width && th >= data->render_target_height)
+    return false;
+  w = tw;
+  h = th;
+  return true;
+}
+
+/* remember the last pass that rendered into only part (the top-left viewport) of its target */
+void
+ArgumentEncodingContext::fgTrackReducedViewport(RenderEncoderData *data) {
+  if (data->render_target_count < 1 || !data->colors[0].attachment)
+    return;
+  double vp_w = 0, vp_h = 0;
+  for (auto c = (wmtcmd_base *)data->cmd_head.next.get(); c; c = (wmtcmd_base *)c->next.get()) {
+    if (c->type == WMTRenderCommandSetViewport) {
+      auto v = (wmtcmd_render_setviewport *)c;
+      vp_w = v->viewport.width; vp_h = v->viewport.height;
+      break;
+    }
+    if (c->type == WMTRenderCommandSetViewports) {
+      auto v = (wmtcmd_render_setviewports *)c;
+      if (v->viewport_count) {
+        auto vps = (WMTViewport *)v->viewports.get();
+        vp_w = vps[0].width; vp_h = vps[0].height;
+      }
+      break;
+    }
+  }
+  if (vp_w < 64 || vp_h < 64)
+    return;
+  /* only full-size targets (the presented size): small passes in between (portraits, icons with
+   * their own viewports) must not replace the source */
+  if (data->render_target_width != fg_present_w_ || data->render_target_height != fg_present_h_)
+    return;
+  bool reduced = vp_w < data->render_target_width - 1 && vp_h < data->render_target_height - 1;
+  if (reduced) {
+    fg_lr_src_ = data->colors[0].attachment.texture();
+    fg_lr_w_ = uint32_t(vp_w);
+    fg_lr_h_ = uint32_t(vp_h);
+  }
+}
+
+bool
+ArgumentEncodingContext::encodeSpatialUpscale(WMT::CommandBuffer &cmdbuf, RenderEncoderData *data, WMT::Texture &target) {
+  auto &st = currentFrameStatistics();
+  st.fsr1_present_w = fg_present_w_;
+  if (!fg_lr_src_) { st.fsr1_state = 2; return false; }
+  st.fsr1_vp_w = fg_lr_w_; st.fsr1_vp_h = fg_lr_h_; st.fsr1_src_w = fg_lr_src_.width();
+  if (fg_lr_src_.width() != target.width() || fg_lr_src_.height() != target.height()) { st.fsr1_state = 3; return false; }
+  /* MetalFX Spatial does not take sRGB formats: run it on the UNORM twin (same bits; the copies
+   * below are raw, so the image is upscaled in gamma space, as FSR1 does) */
+  auto unorm = [](WMTPixelFormat f) {
+    switch (f) {
+    case WMTPixelFormatRGBA8Unorm_sRGB: return WMTPixelFormatRGBA8Unorm;
+    case WMTPixelFormatBGRA8Unorm_sRGB: return WMTPixelFormatBGRA8Unorm;
+    default: return f;
+    }
+  };
+  WMTPixelFormat in_fmt = unorm(fg_lr_src_.pixelFormat()), out_fmt = unorm(target.pixelFormat());
+  st.fsr1_in_fmt = fg_lr_src_.pixelFormat();
+  st.fsr1_out_fmt = target.pixelFormat();
+  if (!fg_lr_scaler_ || fg_lr_info_.input_width != fg_lr_w_ || fg_lr_info_.input_height != fg_lr_h_ ||
+      fg_lr_info_.output_width != target.width() || fg_lr_info_.output_height != target.height() ||
+      fg_lr_info_.color_format != in_fmt || fg_lr_info_.output_format != out_fmt) {
+    WMTFXSpatialScalerInfo info = {};
+    info.color_format = in_fmt;
+    info.output_format = out_fmt;
+    info.input_width = fg_lr_w_;
+    info.input_height = fg_lr_h_;
+    info.output_width = target.width();
+    info.output_height = target.height();
+    fg_lr_info_ = info;
+    fg_lr_scaler_ = device_.newSpatialScaler(info);
+    WMTTextureInfo tex = {};
+    tex.width = fg_lr_w_;
+    tex.height = fg_lr_h_;
+    tex.depth = 1;
+    tex.array_length = 1;
+    tex.type = WMTTextureType2D;
+    tex.mipmap_level_count = 1;
+    tex.sample_count = 1;
+    tex.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite | WMTTextureUsageRenderTarget);
+    tex.options = WMTResourceStorageModePrivate;
+    tex.pixel_format = in_fmt;
+    fg_lr_crop_ = device_.newTexture(tex);
+    tex.width = target.width();
+    tex.height = target.height();
+    tex.pixel_format = out_fmt;
+    fg_lr_up_ = device_.newTexture(tex);
+    if (!fg_lr_fence_)
+      fg_lr_fence_ = device_.newFence();
+    if (!fg_lr_scaler_)
+      ERR("spatial upscale: MetalFX spatial scaler unavailable (", in_fmt, " -> ", out_fmt, ")");
+  }
+  if (!fg_lr_scaler_) { st.fsr1_state = 4; return false; }
+  st.fsr1_state = 5;
+  /* 1. the reduced region -> exactly sized texture */
+  auto crop = cmdbuf.blitCommandEncoder();
+  data->fence_wait.forEach([&](auto id) { crop.waitForFence(fence_pool_[id]); });
+  data->fence_wait_vertex.forEach([&](auto id) { crop.waitForFence(fence_pool_[id]); });
+  wmtcmd_blit_copy_from_texture_to_texture cmd = {};
+  cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+  cmd.next.set(nullptr);
+  cmd.src = fg_lr_src_.handle;
+  cmd.src_size = {fg_lr_w_, fg_lr_h_, 1};
+  cmd.dst = fg_lr_crop_.handle;
+  crop.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+  crop.updateFence(fg_lr_fence_);
+  crop.endEncoding();
+  /* 2. MetalFX Spatial -> full size */
+  cmdbuf.encodeSpatialScale(fg_lr_scaler_, fg_lr_crop_, fg_lr_up_, fg_lr_fence_);
+  /* 3. over the game's own stretched image (its UI is drawn on top afterwards) */
+  auto put = cmdbuf.blitCommandEncoder();
+  put.waitForFence(fg_lr_fence_);
+  cmd.src = fg_lr_up_.handle;
+  cmd.src_size = {target.width(), target.height(), 1};
+  cmd.dst = target.handle;
+  cmd.dst_slice = data->colors[0].slice;
+  cmd.dst_level = data->colors[0].level;
+  put.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+  put.updateFence(fg_lr_fence_);
+  put.endEncoding();
+  return true;
+}
+
+void
+ArgumentEncodingContext::encodeSceneSnapshot(WMT::CommandBuffer &cmdbuf, RenderEncoderData *data) {
+  WMT::Texture target = data->colors[0].attachment.texture();
+  bool upscaled = spatial_upscale_enabled() && !fg_dlss_seen_ && encodeSpatialUpscale(cmdbuf, data, target);
+  if (!fg_scene_ || fg_scene_.pixelFormat() != target.pixelFormat() || fg_scene_.width() != target.width() ||
+      fg_scene_.height() != target.height()) {
+    WMTTextureInfo tex = {};
+    tex.pixel_format = target.pixelFormat();
+    tex.width = target.width();
+    tex.height = target.height();
+    tex.depth = 1;
+    tex.array_length = 1;
+    tex.type = WMTTextureType2D;
+    tex.mipmap_level_count = 1;
+    tex.sample_count = 1;
+    tex.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite | WMTTextureUsageRenderTarget);
+    tex.options = WMTResourceStorageModePrivate;
+    fg_scene_ = device_.newTexture(tex);
+    fg_scene_hist_ = device_.newTexture(tex);
+    fg_scene_hist_valid_ = false;
+    if (!fg_snap_fence_)
+      fg_snap_fence_ = device_.newFence();
+  }
+  auto blit = [&] {
+    uint32_t s0, s1;
+    if (gpuProfileReserve(GpuProfileEntry{GpuProfileKind::Snapshot}, s0, s1)) {
+      WMTSampleBufferAttachmentInfo si{gpu_profile_->buffer().handle, s0, s1};
+      return cmdbuf.blitCommandEncoderWithSampleBuffers(&si, 1);
+    }
+    return cmdbuf.blitCommandEncoder();
+  }();
+  data->fence_wait.forEach([&](auto id) { blit.waitForFence(fence_pool_[id]); });
+  data->fence_wait_vertex.forEach([&](auto id) { blit.waitForFence(fence_pool_[id]); });
+  if (upscaled)
+    blit.waitForFence(fg_lr_fence_);
+  wmtcmd_blit_copy_from_texture_to_texture cmd = {};
+  cmd.type = WMTBlitCommandCopyFromTextureToTexture;
+  cmd.next.set(nullptr);
+  cmd.src = target.handle;
+  cmd.src_slice = data->colors[0].slice;
+  cmd.src_level = data->colors[0].level;
+  cmd.src_size = {target.width(), target.height(), 1};
+  cmd.dst = fg_scene_.handle;
+  blit.encodeCommands((const wmtcmd_blit_nop *)&cmd);
+  blit.updateFence(fg_snap_fence_);
+  blit.endEncoding();
+  fg_snapped_ = true;
+}
+
+/* deadlock-gptk: sharpen at upscale (see sharpen_at_upscale_enabled): MetalFX renders into fg_upsharp_tmp_, then
+ * present_cas (no UI mask) writes the sharpened image into the game's DLSS output. Ordered by the scaler's fence:
+ * the pass waits for MetalFX and updates the fence again, so EndScaler (and the profiler's MetalFX entry) follow. */
+bool
+ArgumentEncodingContext::upscaleSharpenPrepare(WMT::Texture output) {
+  if (fg_sharp_pso_failed_)
+    return false;
+  if (!fg_upsharp_fence_)
+    fg_upsharp_fence_ = device_.newFence();
+  if (!fg_sharp_pso_) {
+    auto func = lib.getLibrary().newFunction("present_cas");
+    WMT::Reference<WMT::Error> err;
+    if (func)
+      fg_sharp_pso_ = device_.newComputePipelineState(func, err);
+    if (!fg_sharp_pso_) {
+      ERR("sharpen: present_cas pipeline unavailable");
+      fg_sharp_pso_failed_ = true;
+      return false;
+    }
+  }
+  if (!fg_upsharp_tmp_ || fg_upsharp_tmp_.width() != output.width() || fg_upsharp_tmp_.height() != output.height() ||
+      fg_upsharp_tmp_.pixelFormat() != output.pixelFormat()) {
+    WMTTextureInfo tex = {};
+    tex.pixel_format = output.pixelFormat();
+    tex.width = output.width();
+    tex.height = output.height();
+    tex.depth = 1;
+    tex.array_length = 1;
+    tex.type = WMTTextureType2D;
+    tex.mipmap_level_count = 1;
+    tex.sample_count = 1;
+    tex.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite | WMTTextureUsageRenderTarget);
+    tex.options = WMTResourceStorageModePrivate;
+    fg_upsharp_tmp_ = device_.newTexture(tex);
+  }
+  return bool(fg_upsharp_tmp_);
+}
+
+void
+ArgumentEncodingContext::encodeUpscaleSharpen(WMT::CommandBuffer &cmdbuf, WMT::Texture output, WMT::Fence fence) {
+  float params[4] = {sharpen_strength(), -1.0f, 0.0f, 0.0f};
+  auto enc = cmdbuf.computeCommandEncoder(false);
+  if (debug_labels_enabled()) enc.setLabel(WMT::String::string("UpscaleSharpen", WMTUTF8StringEncoding));
+  wmtcmd_compute_fence_op wait = {}, update = {}, update_tmp = {};
+  wmtcmd_compute_setpso setpso = {};
+  wmtcmd_compute_settexture t0 = {}, t1 = {}, t2 = {};
+  wmtcmd_compute_setbytes bytes = {};
+  wmtcmd_compute_dispatch dispatch = {};
+  wait.type = WMTComputeCommandWaitForFence;
+  wait.fence = fence.handle;
+  wait.next.set(&setpso);
+  setpso.type = WMTComputeCommandSetPSO;
+  setpso.pso = fg_sharp_pso_.handle;
+  setpso.threadgroup_size = {16, 16, 1};
+  setpso.next.set(&t0);
+  t0.type = WMTComputeCommandSetTexture; t0.texture = fg_upsharp_tmp_.handle; t0.index = 0; t0.next.set(&t1);
+  t1.type = WMTComputeCommandSetTexture; t1.texture = fg_upsharp_tmp_.handle; t1.index = 1; t1.next.set(&t2);
+  t2.type = WMTComputeCommandSetTexture; t2.texture = output.handle; t2.index = 2; t2.next.set(&bytes);
+  bytes.type = WMTComputeCommandSetBytes;
+  bytes.bytes.set(params);
+  bytes.length = sizeof(params);
+  bytes.index = 0;
+  bytes.next.set(&dispatch);
+  dispatch.type = WMTComputeCommandDispatchThreads;
+  dispatch.size = {output.width(), output.height(), 1};
+  dispatch.next.set(&update);
+  update.type = WMTComputeCommandUpdateFence;
+  update.fence = fence.handle;
+  update.next.set(&update_tmp);
+  update_tmp.type = WMTComputeCommandUpdateFence;
+  update_tmp.fence = fg_upsharp_fence_.handle;
+  update_tmp.next.set(nullptr);
+  enc.encodeCommands((const wmtcmd_compute_nop *)&wait);
+  enc.endEncoding();
+}
+
+void
+ArgumentEncodingContext::encodeSharpen(WMT::CommandBuffer &cmdbuf, PresentData *data, WMT::Texture &present_source) {
+  WMT::Texture fin = data->backbuffer;
+  if (!fg_sharp_ || fg_sharp_.width() != fin.width() || fg_sharp_.height() != fin.height() ||
+      fg_sharp_.pixelFormat() != fin.pixelFormat()) {
+    WMTTextureInfo tex = {};
+    tex.pixel_format = fin.pixelFormat();
+    tex.width = fin.width();
+    tex.height = fin.height();
+    tex.depth = 1;
+    tex.array_length = 1;
+    tex.type = WMTTextureType2D;
+    tex.mipmap_level_count = 1;
+    tex.sample_count = 1;
+    tex.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite);
+    tex.options = WMTResourceStorageModePrivate;
+    fg_sharp_ = device_.newTexture(tex);
+  }
+  if (!fg_sharp_pso_) {
+    auto func = lib.getLibrary().newFunction("present_cas");
+    WMT::Reference<WMT::Error> err;
+    if (func)
+      fg_sharp_pso_ = device_.newComputePipelineState(func, err);
+    if (!fg_sharp_pso_) {
+      ERR("sharpen: present_cas pipeline unavailable");
+      return;
+    }
+  }
+  bool scene = fg_snapped_ && fg_scene_ && fg_scene_.width() == fin.width() && fg_scene_.height() == fin.height();
+  float params[4] = {sharpen_strength(), scene ? framegen_param("DXMT_FRAMEGEN_UI_THRESHOLD", 2.0f) / 255.0f : -1.0f,
+                     scene && is_srgb(fg_scene_.pixelFormat()) && !is_srgb(fin.pixelFormat()) ? 1.0f : 0.0f, 0.0f};
+  auto enc = cmdbuf.computeCommandEncoder(false);
+  data->fence_wait.forEach([&](auto id) {
+    wmtcmd_compute_fence_op w = {};
+    w.type = WMTComputeCommandWaitForFence;
+    w.fence = fence_pool_[id].handle;
+    w.next.set(nullptr);
+    enc.encodeCommands((const wmtcmd_compute_nop *)&w);
+  });
+  wmtcmd_compute_fence_op wait_snap = {};
+  wmtcmd_compute_setpso setpso = {};
+  wmtcmd_compute_settexture t0 = {}, t1 = {}, t2 = {};
+  wmtcmd_compute_setbytes bytes = {};
+  wmtcmd_compute_dispatch dispatch = {};
+  wait_snap.type = scene ? WMTComputeCommandWaitForFence : WMTComputeCommandNop;
+  wait_snap.fence = scene ? fg_snap_fence_.handle : 0;
+  wait_snap.next.set(&setpso);
+  setpso.type = WMTComputeCommandSetPSO;
+  setpso.pso = fg_sharp_pso_.handle;
+  setpso.threadgroup_size = {16, 16, 1};
+  setpso.next.set(&t0);
+  t0.type = WMTComputeCommandSetTexture; t0.texture = scene ? fg_scene_.handle : fin.handle; t0.index = 0; t0.next.set(&t1);
+  t1.type = WMTComputeCommandSetTexture; t1.texture = fin.handle; t1.index = 1; t1.next.set(&t2);
+  t2.type = WMTComputeCommandSetTexture; t2.texture = fg_sharp_.handle; t2.index = 2; t2.next.set(&bytes);
+  bytes.type = WMTComputeCommandSetBytes;
+  bytes.bytes.set(params);
+  bytes.length = sizeof(params);
+  bytes.index = 0;
+  bytes.next.set(&dispatch);
+  dispatch.type = WMTComputeCommandDispatchThreads;
+  dispatch.size = {fin.width(), fin.height(), 1};
+  dispatch.next.set(nullptr);
+  enc.encodeCommands((const wmtcmd_compute_nop *)&wait_snap);
+  enc.endEncoding();
+  present_source = fg_sharp_;
+  currentFrameStatistics().fg_scene_mode = scene;
+}
+
+void
+ArgumentEncodingContext::encodeFrameGeneration(WMT::CommandBuffer &cmdbuf, PresentData *data, WMT::Texture &present_source) {
+  if (fg_failed_)
+    return;
+  auto fg_t0 = std::chrono::steady_clock::now();
+  struct FgTimer {
+    FrameStatistics &stats;
+    std::chrono::steady_clock::time_point t0;
+    ~FgTimer() { stats.fg_encode_interval += std::chrono::steady_clock::now() - t0; }
+  } fg_timer{currentFrameStatistics(), fg_t0};
+  /* scene mode: interpolate this frame's UI-free snapshot; else the final image (UI baked in) */
+  bool scene = fg_snapped_ && fg_scene_;
+  fg_snapped_ = false;
+  if (scene)
+    fg_scene_seen_ = true;
+  else if (fg_scene_seen_)
+    return; /* snapshot mode is established: show this frame as is rather than rebuild for the fallback */
+  currentFrameStatistics().fg_scene_mode = scene;
+  currentFrameStatistics().fg_final_format = data->backbuffer.pixelFormat();
+  if (fg_scene_)
+    currentFrameStatistics().fg_scene_format = fg_scene_.pixelFormat();
+  /* DXMT_FRAMEGEN_SHOW=scene: present the UI-free snapshot itself (to check where it is taken) */
+  static bool show_scene = env::getEnvVar("DXMT_FRAMEGEN_SHOW") == "scene";
+  if (show_scene && scene)
+    present_source = fg_scene_;
+  fg_dlss_seen_ = false;
+  WMT::Texture color = scene ? WMT::Texture(fg_scene_) : data->backbuffer;
+  WMT::Texture history = scene ? WMT::Texture(fg_scene_hist_) : WMT::Texture(fg_history_);
+  WMTFXFrameInterpolatorInfo info = {};
+  info.color_format = color.pixelFormat();
+  info.output_format = info.color_format;
+  info.depth_format = data->fg_depth.pixelFormat();
+  info.motion_format = data->fg_motion.pixelFormat();
+  info.input_width = data->fg_depth.width();
+  info.input_height = data->fg_depth.height();
+  info.output_width = color.width();
+  info.output_height = color.height();
+
+  if (!fg_interpolator_ || memcmp(&info, &fg_info_, sizeof(info))) {
+    fg_info_ = info;
+    fg_interpolator_ = device_.newFrameInterpolator(info);
+    currentFrameStatistics().fg_created++;
+    static uint32_t total_created = 0;
+    currentFrameStatistics().fg_total_created = ++total_created;
+    if (!fg_interpolator_) {
+      ERR("framegen: MetalFX frame interpolator unavailable (color ", info.color_format, " depth ",
+          info.depth_format, " motion ", info.motion_format, " ", info.input_width, "x", info.input_height, " -> ",
+          info.output_width, "x", info.output_height, ")");
+      fg_failed_ = true;
+      return;
+    }
+    WMTTextureInfo tex = {};
+    tex.pixel_format = info.color_format;
+    tex.width = info.output_width;
+    tex.height = info.output_height;
+    tex.depth = 1;
+    tex.array_length = 1;
+    tex.type = WMTTextureType2D;
+    tex.mipmap_level_count = 1;
+    tex.sample_count = 1;
+    tex.usage = (WMTTextureUsage)(WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite | WMTTextureUsageRenderTarget);
+    tex.options = WMTResourceStorageModePrivate;
+    fg_history_ = device_.newTexture(tex);
+    fg_output_ = device_.newTexture(tex);
+    /* composed = what gets presented: the final image's format */
+    WMTTextureInfo composed = tex;
+    composed.pixel_format = data->backbuffer.pixelFormat();
+    composed.width = data->backbuffer.width();
+    composed.height = data->backbuffer.height();
+    fg_composed_ = device_.newTexture(composed);
+    if (!fg_compose_pso_) {
+      auto func = lib.getLibrary().newFunction("fg_ui_compose");
+      WMT::Reference<WMT::Error> err;
+      if (func)
+        fg_compose_pso_ = device_.newComputePipelineState(func, err);
+      if (!fg_compose_pso_)
+        ERR("framegen: fg_ui_compose pipeline unavailable, UI will not be protected");
+    }
+    if (!fg_fence_)
+      fg_fence_ = device_.newFence();
+    fg_history_valid_ = false;
+    WARN("framegen: interpolator ", info.input_width, "x", info.input_height, " -> ", info.output_width, "x",
+         info.output_height, " (mode ", framegen_mode(), ")");
+  }
+
+  auto now = std::chrono::steady_clock::now();
+  float dt = std::chrono::duration<float>(now - fg_last_present_).count();
+  fg_last_present_ = now;
+
+  /* order after everything the frame wrote (DXMT resources are untracked: fences) */
+  auto begin = cmdbuf.blitCommandEncoder();
+  data->fence_wait.forEach([&](auto id) { begin.waitForFence(fence_pool_[id]); });
+  if (scene)
+    begin.waitForFence(fg_snap_fence_);
+  begin.updateFence(fg_fence_);
+  begin.endEncoding();
+
+  /* auto (gap filling): every real frame earns dt/refresh display slots; one is its own, the rest
+   * accumulates, and each whole slot becomes one generated frame shown before it. 40 real fps at
+   * 60 Hz -> generated, real, real, generated, ... = 60 shown; 30 -> one per pair; ~60 -> none.
+   * Real frames are never held to a fixed ratio, so input keeps the game's real rate. */
+  bool generate = true;
+  if (framegen_auto()) {
+    float refresh = std::max(framegen_param("DXMT_FRAMEGEN_REFRESH", 60.0f), 24.0f);
+    float slots = dt * refresh;
+    fg_auto_ema_ = fg_auto_ema_ ? fg_auto_ema_ * 0.9f + dt * 1000.0f * 0.1f : dt * 1000.0f;
+    /* below ~5% over budget nothing is missing; ignore single long frames (hitches, loads) */
+    if (slots > 1.05f && slots < 4.0f)
+      fg_auto_credit_ = std::min(fg_auto_credit_ + (slots - 1.0f), 1.5f);
+    else if (slots <= 1.05f)
+      fg_auto_credit_ = std::max(fg_auto_credit_ - 0.1f, 0.0f);
+    generate = fg_auto_credit_ >= 1.0f;
+    if (generate) {
+      fg_auto_credit_ -= 1.0f;
+      fg_auto_toggles_++;
+    }
+    currentFrameStatistics().fg_auto = generate ? 2 : 1;
+    currentFrameStatistics().fg_game_work_ms = fg_auto_ema_;
+    currentFrameStatistics().fg_auto_toggles = fg_auto_toggles_;
+  }
+
+  bool interpolated = false;
+  bool history_valid = (scene ? fg_scene_hist_valid_ : fg_history_valid_) && generate;
+  if (scene != fg_last_scene_mode_) {   /* switching sources: history is from the other one */
+    history_valid = false;
+    fg_last_scene_mode_ = scene;
+  }
+  if (history_valid) {
+    WMTFXFrameInterpolatorProps props = {};
+    /* DLSS scales motion vectors to render-resolution pixels; the interpolator wants pixels of the
+     * color/output texture. DXMT_FRAMEGEN_MVMUL overrides the factor (1 = DLSS's scale as is). */
+    /* the game renders into the top-left input_content_* region of its depth/motion textures */
+    uint32_t content_w = data->fg_props.input_content_width ? data->fg_props.input_content_width : info.input_width;
+    uint32_t content_h = data->fg_props.input_content_height ? data->fg_props.input_content_height : info.input_height;
+    props.content_width = content_w;
+    props.content_height = content_h;
+    float mul_x = framegen_param("DXMT_FRAMEGEN_MVMUL", 1.0f);
+    float mul_y = framegen_param("DXMT_FRAMEGEN_MVMUL", 1.0f);
+    props.motion_vector_scale_x = data->fg_props.motion_vector_scale_x * mul_x;
+    props.motion_vector_scale_y = data->fg_props.motion_vector_scale_y * mul_y;
+    /* DXMT_FRAMEGEN_JITTER scales DLSS's jitter (0 = treat depth/motion as unjittered) */
+    float jitter = framegen_param("DXMT_FRAMEGEN_JITTER", 1.0f);
+    props.jitter_offset_x = data->fg_props.jitter_offset_x * jitter;
+    props.jitter_offset_y = data->fg_props.jitter_offset_y * jitter;
+    props.depth_reversed = data->fg_props.depth_reversed;
+    props.reset = data->fg_props.reset;
+    props.delta_time = std::clamp(dt, 0.001f, 0.25f);
+    props.field_of_view = framegen_param("DXMT_FRAMEGEN_FOV", 60.0f);
+    props.near_plane = framegen_param("DXMT_FRAMEGEN_NEAR", 4.0f);
+    props.far_plane = framegen_param("DXMT_FRAMEGEN_FAR", 20000.0f);
+    props.aspect_ratio = float(info.output_width) / float(info.output_height);
+    cmdbuf.encodeFrameInterpolation(
+        fg_interpolator_, color, history, data->fg_depth, data->fg_motion, fg_output_, fg_fence_, props
+    );
+    interpolated = true;
+    currentFrameStatistics().fg_interpolated++;
+
+    /* UI: unchanged pixels come from the real frame (DXMT_FRAMEGEN_UI=0 disables,
+     * DXMT_FRAMEGEN_UI_THRESHOLD = max per-channel change, default 2/255) */
+    if (fg_compose_pso_ && framegen_param("DXMT_FRAMEGEN_UI", 1.0f) != 0.0f) {
+      float threshold[4] = {framegen_param("DXMT_FRAMEGEN_UI_THRESHOLD", 2.0f) / 255.0f,
+                            framegen_param("DXMT_FRAMEGEN_UI_DEBUG", 0.0f), scene ? 1.0f : 0.0f,
+                            scene && is_srgb(color.pixelFormat()) && !is_srgb(data->backbuffer.pixelFormat()) ? 1.0f : 0.0f};
+      auto enc = cmdbuf.computeCommandEncoder(false);
+      wmtcmd_compute_fence_op wait = {};
+      wmtcmd_compute_setpso setpso = {};
+      wmtcmd_compute_settexture t0 = {}, t1 = {}, t2 = {}, t3 = {};
+      wmtcmd_compute_setbytes bytes = {};
+      wmtcmd_compute_dispatch dispatch = {};
+      wmtcmd_compute_fence_op update = {};
+      wait.type = WMTComputeCommandWaitForFence;
+      wait.fence = fg_fence_.handle;
+      wait.next.set(&setpso);
+      setpso.type = WMTComputeCommandSetPSO;
+      setpso.pso = fg_compose_pso_.handle;
+      setpso.threadgroup_size = {16, 16, 1};
+      setpso.next.set(&t0);
+      /* cur = final image (with UI); prev = scene snapshot of this frame (scene mode) or the

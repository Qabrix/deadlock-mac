+static NTSTATUS
+_WMTSleepPrecise(void *obj) {
+  struct unixcall_sleep_precise *params = obj;
+  static __thread int kq = -1;
+  if (kq < 0)
+    kq = kqueue();
+  if (kq < 0 || !params->ns) {
+    struct timespec ts = {(time_t)(params->ns / 1000000000), (long)(params->ns % 1000000000)};
+    nanosleep(&ts, NULL);
+    return STATUS_SUCCESS;
+  }
+  /* until the deadline: a signal (EINTR) or a stale timer from an interrupted wait re-arms with the remaining time */
+  uint64_t deadline = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + params->ns, now;
+  while ((now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW)) < deadline) {
+    struct kevent ev, out;
+    EV_SET(&ev, 1, EVFILT_TIMER, EV_ADD | EV_ONESHOT, NOTE_NSECONDS | NOTE_CRITICAL, (intptr_t)(deadline - now), NULL);
+    if (kevent(kq, &ev, 1, &out, 1, NULL) < 0 && errno != EINTR)
+      break;
+  }
+  return STATUS_SUCCESS;
+}

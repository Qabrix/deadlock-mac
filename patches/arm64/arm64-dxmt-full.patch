diff --git a/src/d3d11/d3d11_api_prof.hpp b/src/d3d11/d3d11_api_prof.hpp
new file mode 100644
index 0000000..8c8f87e
--- /dev/null
+++ b/src/d3d11/d3d11_api_prof.hpp
@@ -0,0 +1,119 @@
+#pragma once
+/* deadlock-gptk: per-call-type CPU time of the D3D11 API as the game calls it (stats build only,
+ * -Ddxmt_debug=true). Only the outermost call on a thread counts, so nested API calls are not counted
+ * twice. Shown in the HUD ("API", "Present", "Game") to split the game thread's frame between the
+ * game itself and DXMT. */
+#include <atomic>
+#include <cstdint>
+#include <string_view>
+
+#ifdef DXMT_DEBUG
+#include <x86intrin.h>
+#include <windows.h>
+#include <cstdio>
+#include <cstdlib>
+
+namespace dxmt::apiprof {
+
+constexpr unsigned kMaxSlots = 256;
+
+struct Slot {
+  const char *name = nullptr;
+  bool present = false; /* Present/Present1: waiting for the display, kept out of the thread split */
+  std::atomic<uint64_t> ticks{0}, calls{0};
+  std::atomic<uint64_t> calls_other{0}; /* calls from threads other than the Present thread */
+};
+
+inline Slot slots[kMaxSlots];
+inline std::atomic<unsigned> slot_count{0};
+inline thread_local unsigned depth = 0;
+/* thread that calls Present (the game's render-submitting thread) vs. all others */
+inline std::atomic<unsigned long> present_tid{0};
+inline std::atomic<uint64_t> ticks_present_thread{0}, ticks_other_threads{0};
+
+inline unsigned
+register_slot(const char *name) {
+  unsigned id = slot_count.fetch_add(1);
+  if (id >= kMaxSlots)
+    return kMaxSlots - 1;
+  slots[id].name = name;
+  slots[id].present = std::string_view(name).starts_with("Present");
+  return id;
+}
+
+struct Scope {
+  unsigned id;
+  uint64_t t0 = 0;
+  bool outer;
+  explicit Scope(unsigned id) : id(id), outer(depth++ == 0) {
+    if (outer)
+      t0 = __rdtsc();
+  }
+  ~Scope() {
+    if (outer) {
+      auto &s = slots[id];
+      /* the game's D3D11 calls come from one thread at a time; a lost update is harmless here */
+      s.ticks.store(s.ticks.load(std::memory_order_relaxed) + (__rdtsc() - t0), std::memory_order_relaxed);
+      s.calls.store(s.calls.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+      if (GetCurrentThreadId() != present_tid.load(std::memory_order_relaxed))
+        s.calls_other.fetch_add(1, std::memory_order_relaxed);
+      if (s.present) {
+        depth--;
+        return;
+      }
+      auto &t = GetCurrentThreadId() == present_tid.load(std::memory_order_relaxed) ? ticks_present_thread
+                                                                                     : ticks_other_threads;
+      t.store(t.load(std::memory_order_relaxed) + (__rdtsc() - t0), std::memory_order_relaxed);
+    }
+    depth--;
+  }
+};
+
+/* deadlock-gptk: event counters (any nesting depth) and a periodic dump of all slots to
+ * DXMT_APIPROF_LOG: per slot the calls on the Present thread and on other threads (deferred contexts). */
+inline void
+event(unsigned id) {
+  auto &s = slots[id];
+  s.calls.fetch_add(1, std::memory_order_relaxed);
+  if (GetCurrentThreadId() != present_tid.load(std::memory_order_relaxed))
+    s.calls_other.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline void
+dump_tick() {
+  static unsigned frames = 0;
+  if (++frames % 120)
+    return;
+  static FILE *f = [] {
+    const char *p = getenv("DXMT_APIPROF_LOG");
+    return p && *p ? fopen(p, "a") : (FILE *)nullptr;
+  }();
+  if (!f)
+    return;
+  static uint64_t last_calls[kMaxSlots], last_other[kMaxSlots];
+  fprintf(f, "== frame %u (120 frames): name  present-thread  other-threads\n", frames);
+  unsigned n = slot_count.load() < kMaxSlots ? slot_count.load() : kMaxSlots;
+  for (unsigned i = 0; i < n; i++) {
+    uint64_t c = slots[i].calls.load(), o = slots[i].calls_other.load();
+    if (c != last_calls[i] && slots[i].name)
+      fprintf(f, "  %-44s %8llu %8llu\n", slots[i].name, (unsigned long long)(c - last_calls[i] - (o - last_other[i])),
+              (unsigned long long)(o - last_other[i]));
+    last_calls[i] = c;
+    last_other[i] = o;
+  }
+  fflush(f);
+}
+} // namespace dxmt::apiprof
+
+#define DXMT_API_PROF(name)                                                                                            \
+  static const unsigned dxmt_prof_id_ = ::dxmt::apiprof::register_slot(name);                                         \
+  ::dxmt::apiprof::Scope dxmt_prof_scope_(dxmt_prof_id_)
+#define DXMT_API_EVENT(name)                                                                                           \
+  do {                                                                                                                 \
+    static const unsigned dxmt_ev_id_ = ::dxmt::apiprof::register_slot(name);                                         \
+    ::dxmt::apiprof::event(dxmt_ev_id_);                                                                               \
+  } while (0)
+#else
+#define DXMT_API_PROF(name)
+#define DXMT_API_EVENT(name) do {} while (0)
+#endif

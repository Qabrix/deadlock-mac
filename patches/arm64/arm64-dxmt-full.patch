+/* deadlock-gptk: with NvAPI active, Deadlock's renderer hands its multi-draw-indirect batches to NvAPI instead of its
+ * own path (dispatcher at rendersystemdx11 0x180049a90: AGS, else NvAPI, else the generic path; the NvAPI result is
+ * ignored), so a missing function silently dropped those draws (invisible objects). NVIDIA's semantics: drawCount
+ * indirect draws with their arguments at alignedByteOffsetForArgs + i * alignedByteStrideForArgs. */
+/* deadlock-gptk: with NvAPI up, Deadlock hands its GPU-culled draws to MultiDraw*Indirect; we pass each batch to
+ * one batched DXMT front-end pass (IMTLD3D11ContextExt2; DXMT_MDI_LOOP=1: single D3D11 indirect draws). With
+ * DXMT_NVAPI_LOG set: every ~5 s calls, draws, batch-size histogram, the time spent in the call (render-thread CPU)
+ * and the biggest batch. */
+namespace {
+struct MdiStats {
+  std::mutex m;
+  NvU64 t0 = 0, calls = 0, draws = 0, max_count = 0, loop_us = 0;
+  NvU64 hist[6] = {}; /* drawCount 1, 2-8, 9-64, 65-512, 513-4096, >4096 */
+};
+MdiStats &mdi_stats() {
+  static MdiStats s;
+  return s;
+}
+/* DXMT's batched path (IMTLD3D11ContextExt2), cached per calling thread for the last context; nullptr = unroll
+ * here (no DXMT ext, or DXMT_MDI_LOOP=1 for comparison) */
+IMTLD3D11ContextExt2 *mdi_ext(ID3D11DeviceContext *ctx) {
+  static bool loop = [] {
+    char v[8];
+    DWORD n = GetEnvironmentVariableA("DXMT_MDI_LOOP", v, sizeof(v));
+    return n && n < sizeof(v) && v[0] == '1';
+  }();
+  if (loop)
+    return nullptr;
+  thread_local ID3D11DeviceContext *last_ctx = nullptr;
+  thread_local Com<IMTLD3D11ContextExt2> last_ext;
+  if (ctx != last_ctx) {
+    last_ext = nullptr;
+    ctx->QueryInterface(IID_PPV_ARGS(&last_ext));
+    last_ctx = ctx;
+  }
+  return last_ext.ptr();
+}
+void mdi_account(bool indexed, bool batched, NvU32 count, NvU64 t_begin, NvU64 t_end) {
+  if (!nvapi_log_file())
+    return;
+  auto &s = mdi_stats();
+  std::lock_guard<std::mutex> lock(s.m);
+  s.calls++;
+  s.draws += count;
+  s.max_count = std::max<NvU64>(s.max_count, count);
+  s.hist[count <= 1 ? 0 : count <= 8 ? 1 : count <= 64 ? 2 : count <= 512 ? 3 : count <= 4096 ? 4 : 5]++;
+  if (!t_end) /* untimed call: counted only */
+    return;
+  s.loop_us += 16 * (t_end - t_begin); /* one call in 16 is timed */
+  if (!s.t0)
+    s.t0 = t_end;
+  if (t_end - s.t0 >= 5000000) {
+    double secs = double(t_end - s.t0) / 1e6;
+    FILE *log = nvapi_log_file();
+    fprintf(log,
+            "MultiDraw%s%s per-s: calls %.0f draws %.0f (max batch %llu) loop %.2f ms/s | batches 1:%llu 2-8:%llu "
+            "9-64:%llu 65-512:%llu 513-4096:%llu >4096:%llu\n",
+            indexed ? "Indexed" : "", batched ? " (batched)" : " (loop)", s.calls / secs, s.draws / secs, (unsigned long long)s.max_count,
+            s.loop_us / secs / 1000, (unsigned long long)s.hist[0], (unsigned long long)s.hist[1],
+            (unsigned long long)s.hist[2], (unsigned long long)s.hist[3], (unsigned long long)s.hist[4],
+            (unsigned long long)s.hist[5]);
+    fflush(log);
+    NvU64 keep = t_end;
+    s.calls = s.draws = s.max_count = s.loop_us = 0;
+    memset(s.hist, 0, sizeof(s.hist));
+    s.t0 = keep;
+  }
+}

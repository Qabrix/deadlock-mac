diff --git a/src/dxmt/dxmt_gpu_profile.cpp b/src/dxmt/dxmt_gpu_profile.cpp
new file mode 100644
index 0000000..d7d0bea
--- /dev/null
+++ b/src/dxmt/dxmt_gpu_profile.cpp
@@ -0,0 +1,196 @@
+#include "dxmt_gpu_profile.hpp"
+#include "log/log.hpp"
+#include "util_env.hpp"
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <ctime>
+#include <map>
+#include <string>
+
+namespace dxmt {
+
+bool
+gpu_profile_enabled() {
+  static bool on = !env::getEnvVar("DXMT_GPU_PROFILE").empty();
+  return on;
+}
+
+namespace {
+
+const char *const kKindNames[] = {"render", "compute", "blit", "clear", "resolve", "metalfx", "present", "snapshot"};
+
+struct Agg {
+  double ticks = 0; // exclusive: time this pass extended the chunk's GPU timeline beyond earlier passes
+  double span = 0;  // inclusive: start..end of the pass (overlaps other passes)
+  uint64_t count = 0;
+  uint64_t draws = 0;
+  double kb = 0;
+};
+
+/* only the finish thread touches this */
+struct State {
+  FILE *f = nullptr;
+  bool opened = false;
+  std::map<std::string, Agg> keys;
+  double kind_ticks[size_t(GpuProfileKind::Count)] = {};
+  double kind_span[size_t(GpuProfileKind::Count)] = {};
+  double kind_kb[size_t(GpuProfileKind::Count)] = {};
+  double busy_ticks = 0;
+  uint64_t kind_count[size_t(GpuProfileKind::Count)] = {};
+  uint64_t last_frame = ~0ull, frames = 0;
+  double span_ticks = 0, span_ns = 0;
+  std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+} st;
+
+void
+pass_key(char *out, size_t size, const GpuProfileEntry &e) {
+  switch (e.kind) {
+  case GpuProfileKind::Render:
+    snprintf(out, size, "render %ux%u c%u%s f%u", e.width, e.height, e.colors, e.depth ? "+d" : "", e.format);
+    break;
+  case GpuProfileKind::Clear:
+  case GpuProfileKind::Resolve:
+  case GpuProfileKind::MetalFX:
+  case GpuProfileKind::Present:
+    snprintf(out, size, "%s %ux%u", kKindNames[size_t(e.kind)], e.width, e.height);
+    break;
+  default:
+    snprintf(out, size, "%s", kKindNames[size_t(e.kind)]);
+  }
+}
+
+void
+report() {
+  auto now = std::chrono::steady_clock::now();
+  double secs = std::chrono::duration<double>(now - st.t0).count();
+  if (secs < 5.0 || !st.frames)
+    return;
+  /* GPU timestamp unit, calibrated against the command buffers' GPU start/end times (ns); Apple GPUs
+   * report either ns or 24 MHz ticks, so snap near those */
+  double raw = st.span_ticks > 0 ? st.span_ns / st.span_ticks : 1.0;
+  double tick_ns = (raw > 0.8 && raw < 1.35) ? 1.0 : (raw > 33 && raw < 50) ? 125.0 / 3.0 : raw;
+  double per_frame = tick_ns / 1e6 / st.frames;
+  double sum = 0;
+  {
+    time_t wall = time(nullptr);
+    char hm[16];
+    strftime(hm, sizeof(hm), "%H:%M:%S", localtime(&wall));
+    fprintf(st.f, "%s ", hm);
+  }
+  fprintf(st.f, "[gpu] %.1f s, %llu frames (%.1f fps), GPU busy %.2f ms/frame, tick %.3f ns (raw %.3f)\n", secs,
+          (unsigned long long)st.frames, st.frames / secs, st.busy_ticks * per_frame, tick_ns, raw);
+  fprintf(st.f, "  exclusive ms/frame (passes/frame) [span]:");
+  for (size_t k = 0; k < size_t(GpuProfileKind::Count); k++) {
+    if (!st.kind_count[k])
+      continue;
+    fprintf(st.f, " %s %.2f (%.1f) [%.2f]", kKindNames[k], st.kind_ticks[k] * per_frame,
+            double(st.kind_count[k]) / st.frames, st.kind_span[k] * per_frame);
+    sum += st.kind_ticks[k] * per_frame;
+  }
+  fprintf(st.f, " | sum %.2f\n", sum);
+  double mb = 0;
+  fprintf(st.f, "  attachment traffic MB/frame (estimate, uncompressed):");
+  for (size_t k = 0; k < size_t(GpuProfileKind::Count); k++) {
+    if (!st.kind_count[k] || !st.kind_kb[k])
+      continue;
+    fprintf(st.f, " %s %.1f", kKindNames[k], st.kind_kb[k] / 1024.0 / st.frames);
+    mb += st.kind_kb[k] / 1024.0 / st.frames;
+  }
+  fprintf(st.f, " | sum %.1f MB/frame = %.2f GB/s\n", mb, mb * st.frames / secs / 1024.0);
+  std::vector<std::pair<std::string, Agg>> top(st.keys.begin(), st.keys.end());
+  std::sort(top.begin(), top.end(), [](auto &a, auto &b) { return a.second.ticks > b.second.ticks; });
+  for (size_t i = 0; i < top.size() && i < 24; i++) {
+    auto &[key, a] = top[i];
+    fprintf(st.f, "  %6.2f ms [span %6.2f] %5.1f/f  %-40s draws/pass %3.0f  %6.1f MB/f\n", a.ticks * per_frame,
+            a.span * per_frame, double(a.count) / st.frames, key.c_str(), a.count ? double(a.draws) / a.count : 0.0,
+            a.kb / 1024.0 / st.frames);
+  }
+  fflush(st.f);
+  FILE *f = st.f;
+  st = State{};
+  st.f = f;
+  st.opened = true;
+  st.t0 = now;
+}
+
+} // namespace
+
+bool
+GpuProfileChunk::reserve(WMT::Device device, const GpuProfileEntry &entry, uint32_t &start, uint32_t &end) {
+  if (failed_ || entries_.size() >= kMaxEntries)
+    return false;
+  if (sbuf_ == nullptr) {
+    sbuf_ = device.newCounterSampleBuffer(kMaxEntries * 2, true);
+    if (sbuf_ == nullptr) {
+      failed_ = true;
+      WARN("gpu profile: no counter sample buffer");
+      return false;
+    }
+  }
+  start = uint32_t(entries_.size() * 2);
+  end = start + 1;
+  entries_.push_back(entry);
+  return true;
+}
+
+void
+GpuProfileChunk::collect(uint64_t frame, WMT::CommandBuffer cmdbuf) {
+  if (entries_.empty() || sbuf_ == nullptr)
+    return;
+  if (!st.opened) {
+    st.opened = true;
+    st.f = fopen(env::getEnvVar("DXMT_GPU_PROFILE").c_str(), "a");
+  }
+  if (!st.f)
+    return;
+  uint32_t n = uint32_t(entries_.size() * 2);
+  std::vector<uint64_t> ts(n, 0);
+  sbuf_.resolveCounterRange(0, n, ts.data(), n * sizeof(uint64_t));
+  uint64_t lo = ~0ull, hi = 0;
+  char key[96];
+  /* passes in GPU start order; each one is charged only for the time it extends the timeline beyond the
+   * latest end so far (overlapping execution and waiting behind earlier passes are not charged twice) */
+  std::vector<uint32_t> order;
+  order.reserve(entries_.size());
+  for (uint32_t i = 0; i < entries_.size(); i++) {
+    uint64_t t0 = ts[2 * i], t1 = ts[2 * i + 1];
+    if (t0 && t1 && t0 != ~0ull && t1 != ~0ull && t1 >= t0)
+      order.push_back(i);
+  }
+  std::sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b) { return ts[2 * a] < ts[2 * b]; });
+  uint64_t cursor = 0;
+  for (uint32_t i : order) {
+    uint64_t t0 = ts[2 * i], t1 = ts[2 * i + 1];
+    lo = std::min(lo, t0);
+    hi = std::max(hi, t1);
+    uint64_t from = std::max(t0, cursor);
+    double excl = t1 > from ? double(t1 - from) : 0.0;
+    cursor = std::max(cursor, t1);
+    auto &e = entries_[i];
+    st.kind_ticks[size_t(e.kind)] += excl;
+    st.kind_span[size_t(e.kind)] += double(t1 - t0);
+    st.kind_count[size_t(e.kind)]++;
+    st.kind_kb[size_t(e.kind)] += e.kb;
+    st.busy_ticks += excl;
+    pass_key(key, sizeof(key), e);
+    auto &a = st.keys[key];
+    a.ticks += excl;
+    a.span += double(t1 - t0);
+    a.count++;
+    a.draws += e.draws;
+    a.kb += e.kb;
+  }
+  uint64_t g0 = cmdbuf.gpuStartTime(), g1 = cmdbuf.gpuEndTime();
+  if (hi > lo && g1 > g0) {
+    st.span_ticks += double(hi - lo);
+    st.span_ns += double(g1 - g0);
+  }
+  if (frame != st.last_frame) {
+    st.last_frame = frame;
+    st.frames++;
+  }
+  report();
+}
+
+} // namespace dxmt

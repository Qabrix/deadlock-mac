+
+/* deadlock-gptk: WINE_MAINTHRD_QOS=1 maps the Windows thread named MainThrd to the top
+ * non-realtime Mach QoS tier (USER_INTERACTIVE). Opt-in; for sustained FPS under thermal fair. */
+static int mainthrd_qos(void)
+{
+    static int boost = -1;
+    if (boost < 0)
+    {
+        const char *env = getenv( "WINE_MAINTHRD_QOS" );
         boost = env && env[0] == '1';
     }
     return boost;
+}
+
+static int thread_desc_is_mainthrd( const struct thread *thread )
+{
+    static const WCHAR name[] = {'M','a','i','n','T','h','r','d'};
+    return thread->desc && thread->desc_len == sizeof(name)
+           && !memcmp( thread->desc, name, sizeof(name) );
+}
+
+/* deadlock-gptk: WINE_JOBTHRD_QOS=1 puts the game's performance-core job workers (GlobPool/P*),
+ * which MainThrd waits on every frame, above the DXMT encode/audio/render threads and just below
+ * MainThrd; the game creates them below normal, so busy P-cores kept preempting them. */
+static int jobthrd_qos(void)
+{
+    static int boost = -1;
+    if (boost < 0)
+    {
+        const char *env = getenv( "WINE_JOBTHRD_QOS" );
+        boost = env && env[0] == '1';
+    }
+    return boost;
+}
+
+static int thread_desc_is_pjob( const struct thread *thread )
+{
+    static const WCHAR prefix[] = {'G','l','o','b','P','o','o','l','/','P'};
+    return thread->desc && thread->desc_len >= sizeof(prefix)
+           && !memcmp( thread->desc, prefix, sizeof(prefix) );
+}
+
+/* deadlock-gptk: with WINE_ECORE_THREADS set (see ntdll patch 0018), threads on that list must
+ * never get the legacy Mach policies below: once a thread has them, macOS refuses the QoS class
+ * the thread later sets on itself (EPERM). The game lowers its job workers' priority before it
+ * names them, so unnamed below-normal threads are left alone too. */
+static int ecore_skip_policies( const struct thread *thread )
+{
+    static char list[512];
+    static int init;
+    const char *p;
+
+    if (!init)
+    {
+        const char *env = getenv( "WINE_ECORE_THREADS" );
+        if (env) snprintf( list, sizeof(list), "%s", env );
+        init = 1;
+    }
+    if (!list[0]) return 0;
+    if (!thread->desc) return thread->base_priority < THREAD_PRIORITY_NORMAL;
+    for (p = list; *p; )
+    {
+        const char *end = strchr( p, ',' );
+        size_t i, len = end ? (size_t)(end - p) : strlen( p );
+        if (len && len <= thread->desc_len / sizeof(WCHAR))
+        {
+            for (i = 0; i < len; i++) if (thread->desc[i] != (unsigned char)p[i]) break;
+            if (i == len) return 1;
+        }
+        if (!end) break;
+        p = end + 1;
+    }
+    return 0;
 }
 

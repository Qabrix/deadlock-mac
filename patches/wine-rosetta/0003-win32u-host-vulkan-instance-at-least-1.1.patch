+    if (create_info->pApplicationInfo) host_app_info = *create_info->pApplicationInfo;
+    if (host_app_info.apiVersion < VK_API_VERSION_1_1)
+    {
+        host_app_info.apiVersion = VK_API_VERSION_1_3;
+        create_info->pApplicationInfo = &host_app_info;
+    }
+
     if ((res = p_vkCreateInstance( create_info, NULL /* allocator */, &host_instance ))) goto failed;
 
     vulkan_object_init_ptr( &instance->obj.obj, (UINT_PTR)host_instance, &client_instance->obj );

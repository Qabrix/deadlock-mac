--- a/dlls/winecoreaudio.drv/coreaudio.c	2026-10-13 22:30:56
+++ b/dlls/winecoreaudio.drv/coreaudio.c	2026-10-13 22:30:56
@@ -1198,6 +1198,17 @@
     if(FAILED(params->result = get_device_sample_rate(dev_id, params->flow, &params->fmt->Format.nSamplesPerSec)))
         return STATUS_SUCCESS;
 
+    /* deadlock-gptk: WINE_COREAUDIO_MIX_RATE=<Hz> reports that rate as the shared-mode mix format
+     * for playback. Games mix at the mix-format rate; at a 96 kHz device that doubles their (here:
+     * Rosetta-translated) mixing work. The output AudioUnit converts to the device rate natively,
+     * so the device itself keeps its rate. */
+    if(params->flow == eRender){
+        const char *env = getenv("WINE_COREAUDIO_MIX_RATE");
+        unsigned int rate = env ? strtoul(env, NULL, 10) : 0;
+        if(rate >= 8000 && rate <= 384000 && rate < params->fmt->Format.nSamplesPerSec)
+            params->fmt->Format.nSamplesPerSec = rate;
+    }
+
     params->fmt->Format.wBitsPerSample = 32;
     params->fmt->SubFormat = KSDATAFORMAT_SUBTYPE_IEEE_FLOAT;
 

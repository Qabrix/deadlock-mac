+#ifdef __APPLE__
+#include <sys/resource.h>
+#include <pthread/qos.h>
+/* deadlock-gptk: WINE_ECORE_THREADS="GlobPool/P,AudioMixer" (name prefixes) moves the threads that name
+ * themselves so onto the efficiency cores: darwin background (default, strictly E-cores) or
+ * WINE_ECORE_MODE=utility (QoS utility, E-preferred). With fewer busy performance cores the P-cluster
+ * keeps a higher clock for the threads left there (MainThrd). */
+static void ecore_for_thread_name( const char *name )
+{
+    static char list[512];
+    static int mode = -1;
+    const char *p;
+
+    if (mode < 0)
+    {
+        const char *e = getenv( "WINE_ECORE_THREADS" ), *m = getenv( "WINE_ECORE_MODE" );
+        if (e) snprintf( list, sizeof(list), "%s", e );
+        mode = (m && !strcmp( m, "utility" )) ? 1 : 0;
+    }
+    for (p = list; *p; )
+    {
+        const char *end = strchr( p, ',' );
+        size_t len = end ? (size_t)(end - p) : strlen( p );
+        if (len && !strncmp( name, p, len ))
+        {
+            if (mode) pthread_set_qos_class_self_np( QOS_CLASS_UTILITY, 0 );
+            else setpriority( PRIO_DARWIN_THREAD, 0, PRIO_DARWIN_BG );
+            return;
+        }
+        if (!end) break;
+        p = end + 1;
+    }
 }
+#endif
 

+/* deadlock-gptk: WINE_MOUSE_MOVE_HZ=N sends mouse moves to Windows at most N times a second per thread.
+ * Moves in between are added up (relative deltas summed, the latest absolute position kept), so no
+ * motion is lost; any remainder goes out with the next event or event pass after the interval. A
+ * 1000 Hz mouse otherwise keeps a game's message loop busy (every move is a hardware input + raw input
+ * message through the wineserver; under Rosetta the loop never empties and SDL spends ~10 ms a frame). */
+static UINT mouse_move_interval_ms(void)
+{
+    static int interval = -1;
+    if (interval < 0)
+    {
+        const char *s = getenv("WINE_MOUSE_MOVE_HZ");
+        int hz = s ? atoi(s) : 0;
+        interval = hz > 0 ? (1000 + hz - 1) / hz : 0;
+    }
+    return interval;
+}
+
+static void send_mouse_moved(HWND hwnd, const macdrv_event *event)
+{
+    UINT flags = MOUSEEVENTF_MOVE;
+
+    if (event->type == MOUSE_MOVED_ABSOLUTE)
+        flags |= MOUSEEVENTF_ABSOLUTE;
+
+    send_mouse_input(hwnd, event->window, flags, event->mouse_moved.x, event->mouse_moved.y,
+                     0, event->mouse_moved.drag, event->mouse_moved.time_ms);
+}
+
+void macdrv_flush_mouse_moved(BOOL force)
+{
+    struct macdrv_thread_data *data = macdrv_thread_data();
+
+    if (!data || !data->mouse_move_pending) return;
+    if (!force && NtGetTickCount() - data->mouse_move_last_sent < mouse_move_interval_ms()) return;
+    data->mouse_move_pending = FALSE;
+    data->mouse_move_last_sent = NtGetTickCount();
+    send_mouse_moved(data->mouse_move_hwnd, &data->mouse_move_event);
+}

--- a/dlls/winecoreaudio.drv/coreaudio.c
+++ b/dlls/winecoreaudio.drv/coreaudio.c
@@ -788,6 +788,21 @@
     return S_OK;
 }
 
+/* deadlock-gptk: WINE_COREAUDIO_MIN_PERIOD_MS raises the default/stream period to at least
+ * that many milliseconds. Wine takes the device's I/O buffer size as the period, which at
+ * high sample rates (96 kHz) is ~5 ms and underruns while a game loads the CPU. */
+static unsigned int env_min_period_frames(unsigned int rate)
+{
+    static int ms = -1;
+    if (ms < 0)
+    {
+        const char *env = getenv("WINE_COREAUDIO_MIN_PERIOD_MS");
+        ms = env ? atoi(env) : 0;
+        if (ms < 0 || ms > 100) ms = 0;
+    }
+    return ms ? muldiv(ms, rate, 1000) : 0;
+}
+

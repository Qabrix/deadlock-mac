diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index cdea7b2..c11b1dc 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -1180,12 +1180,44 @@ GPT_ABI_WRAPPER( NtReleaseSemaphore );
 /**************************************************************************
  *              NtCreateEvent (NTDLL.@)
  */
+/* deadlock-gptk: WINE_EVENT_PREFILL=1 caches the in-process sync info returned by create_event (msync) */
+static BOOL event_prefill_enabled(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *s = getenv( "WINE_EVENT_PREFILL" );
+        on = s && *s == '1';
+    }
+    return on;
+}
+
+static void prefill_inproc_sync( HANDLE handle, struct inproc_sync *stack )
+{
+    struct inproc_sync *sync;
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    if ((sync = get_cached_inproc_sync( handle )))
+        release_inproc_sync( sync );  /* already cached (shouldn't happen for a new handle) */
+    else
+    {
+        sync = cache_inproc_sync( handle, stack );
+        /* cached: drop the caller's reference, the handle keeps one; not cacheable: nothing keeps it, release it
+         * the same way a stack copy from get_inproc_sync() is released after use */
+        release_inproc_sync( sync );
+    }
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+}
+
 NTSTATUS WINAPI GPT_IMPORT(NtCreateEvent)( HANDLE *handle, ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr,
                                            EVENT_TYPE type, BOOLEAN state )
 {
     unsigned int ret;
     data_size_t len;
     struct object_attributes *objattr;
+    struct inproc_sync inproc;
+    BOOL have_inproc = FALSE;
 
     TRACE( "access %#x, name %s, type %u, state %u\n", access,
            attr ? debugstr_us(attr->ObjectName) : "(null)", type, state );
@@ -1202,9 +1234,22 @@ NTSTATUS WINAPI GPT_IMPORT(NtCreateEvent)( HANDLE *handle, ACCESS_MASK access, c
         wine_server_add_data( req, objattr, len );
         ret = wine_server_call( req );
         *handle = wine_server_ptr_handle( reply->handle );
+        if (*handle && reply->inproc_valid && event_prefill_enabled())
+        {
+            inproc.refcount = 1;
+            inproc.fd = reply->shm_idx;
+            inproc.access = reply->inproc_access;
+            inproc.type = reply->inproc_type;
+            inproc.closed = 0;
+            have_inproc = TRUE;
+        }
     }
     SERVER_END_REQ;
 
+    /* deadlock-gptk: the create reply already carried the in-process sync info: cache it now, so the first wait or
+     * set on this handle doesn't need a get_inproc_sync_fd round trip to the server */
+    if (have_inproc) prefill_inproc_sync( *handle, &inproc );
+
     free( objattr );
     return ret;
 }

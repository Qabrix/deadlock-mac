diff --git a/server/inproc_sync.c b/server/inproc_sync.c
index d3dfab4..aac9740 100644
--- a/server/inproc_sync.c
+++ b/server/inproc_sync.c
@@ -446,6 +446,30 @@ static int get_obj_inproc_sync( struct object *obj, int *type )
 
 #endif /* NTSYNC_IOC_EVENT_READ */
 
+/* deadlock-gptk: in-process sync info of a handle the caller just created, so the create reply can carry it and the
+ * client skips the get_inproc_sync_fd round trip on the first wait/set (msync only: the "fd" is a shm index) */
+int get_handle_inproc_sync_info( struct process *process, obj_handle_t handle, int *type,
+                                 unsigned int *access, unsigned int *idx )
+{
+    struct object *obj;
+    unsigned int error = get_error();
+    int fd;
+
+    if (!do_msync()) return 0;
+    if (!(obj = get_handle_obj( process, handle, 0, NULL )))
+    {
+        set_error( error );
+        return 0;
+    }
+    *access = get_handle_access( process, handle );
+    fd = get_obj_inproc_sync( obj, type );
+    release_object( obj );
+    set_error( error );
+    if (fd < 0) return 0;
+    *idx = (unsigned int)fd;
+    return 1;
+}
+
 DECL_HANDLER(get_inproc_sync_fd)
 {
     struct object *obj;

+/* --- the overlay inside the game's frame (DXMT, our builds) ---
+ * The panel above was a window over the game, so the window server composited every frame while it showed. DXMT's
+ * present pass instead calls macdrv_parkour_overlay_lock (winemetal, dlsym) for each frame and, when the version
+ * changed, copies the bitmap into a texture it blends over the drawable. The bitmap is rendered here on
+ * parkour_draw_queue: on every change of rows/status/running, and 10x/s while the stopwatch runs. The first call
+ * from DXMT switches the panel off for good. */
+#include <os/lock.h>
 
+static os_unfair_lock parkour_frame_lock = OS_UNFAIR_LOCK_INIT;
+static BOOL parkour_frame_seen;              /* DXMT asked: draw into the frame, no panel */
+static NSString *parkour_frame_rows, *parkour_frame_status;  /* snapshot of the main thread's state */
+static BOOL parkour_frame_running;
+static NSTimeInterval parkour_frame_start;
+static void *parkour_frame_pixels;           /* premultiplied BGRA, top row first */
+static uint32_t parkour_frame_width, parkour_frame_height;
+static uint64_t parkour_frame_version;
+static double parkour_frame_scale = 1, parkour_frame_rendered_scale;
+static dispatch_source_t parkour_frame_tick;
 
+static CTLineRef parkour_frame_line(NSString *text, CTFontRef font)
+{
+    NSAttributedString *s = [[NSAttributedString alloc] initWithString:text
+                                                            attributes:@{ (id)kCTFontAttributeName: (id)font,
+                                                                          (id)kCTForegroundColorFromContextAttributeName: @YES }];
+    CTLineRef line = CTLineCreateWithAttributedString((CFAttributedStringRef)s);
+
+    [s release];
+    return line;
+}
+
+/* parkour_draw_queue */
+static void parkour_frame_render(void)
+{
+    NSString *rows, *status;
+    BOOL running;
+    NSTimeInterval start;
+    double scale;
+    NSMutableArray *texts = [NSMutableArray array];
+    void *pixels = NULL;
+    uint32_t width = 0, height = 0;
+
+    os_unfair_lock_lock(&parkour_frame_lock);
+    rows = [parkour_frame_rows retain];
+    status = [parkour_frame_status retain];
+    running = parkour_frame_running;
+    start = parkour_frame_start;
+    scale = parkour_frame_scale;
+    os_unfair_lock_unlock(&parkour_frame_lock);
+
+    if ([rows length]) [texts addObjectsFromArray:[rows componentsSeparatedByString:@"\n"]];
+    if (running) [texts addObject:parkour_clock_text([[NSProcessInfo processInfo] systemUptime] - start)];
+    if ([status length]) [texts addObject:status];
+
+    if ([texts count])
+    {
+        CTFontRef font = CTFontCreateCopyWithAttributes((CTFontRef)[parkour_attrs objectForKey:NSFontAttributeName],
+                                                        20 * scale, NULL, NULL);
+        CGFloat ascent = CTFontGetAscent(font), descent = CTFontGetDescent(font), leading = CTFontGetLeading(font);
+        CGFloat line_height = ceil(ascent + descent + leading), pad_x = ceil(12 * scale), pad_y = ceil(8 * scale);
+        CGFloat text_width = 0;
+        NSMutableArray *lines = [NSMutableArray array];
+        CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+        CGContextRef ctx;
+        NSUInteger i;
+
+        if (running)   /* room for minutes: the box doesn't grow while the clock runs */
+        {
+            CTLineRef wide = parkour_frame_line(parkour_clock_text(600), font);
+            text_width = CTLineGetTypographicBounds(wide, NULL, NULL, NULL);
+            CFRelease(wide);
+        }
+        for (NSString *text in texts)
+        {
+            CTLineRef line = parkour_frame_line(text, font);
+            text_width = MAX(text_width, CTLineGetTypographicBounds(line, NULL, NULL, NULL));
+            [lines addObject:(id)line];
+            CFRelease(line);
+        }
+        width = MIN(512, (uint32_t)ceil(text_width + 2 * pad_x));
+        height = MIN(1024, (uint32_t)(line_height * [lines count] + 2 * pad_y));
+        pixels = calloc((size_t)width * height, 4);
+        ctx = CGBitmapContextCreate(pixels, width, height, 8, width * 4, srgb,
+                                    kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
+        if (ctx)
+        {
+            CGPathRef box = CGPathCreateWithRoundedRect(CGRectMake(0, 0, width, height), 8 * scale, 8 * scale, NULL);
+            CGContextSetRGBFillColor(ctx, 0, 0, 0, 0.55);
+            CGContextAddPath(ctx, box);
+            CGContextFillPath(ctx);
+            CGPathRelease(box);
+            CGContextSetRGBFillColor(ctx, 1, 1, 1, 1);
+            for (i = 0; i < [lines count]; i++)
+            {
+                CGContextSetTextPosition(ctx, pad_x, height - pad_y - ascent - line_height * i);
+                CTLineDraw((CTLineRef)[lines objectAtIndex:i], ctx);
+            }
+            CGContextRelease(ctx);
+        }
+        else
+        {
+            free(pixels);
+            pixels = NULL;
+            width = height = 0;
+        }
+        CGColorSpaceRelease(srgb);
+        CFRelease(font);
+    }
+    [rows release];
+    [status release];
+
+    os_unfair_lock_lock(&parkour_frame_lock);
+    free(parkour_frame_pixels);
+    parkour_frame_pixels = pixels;
+    parkour_frame_width = width;
+    parkour_frame_height = height;
+    parkour_frame_rendered_scale = scale;
+    parkour_frame_version++;
+    os_unfair_lock_unlock(&parkour_frame_lock);
+}
+
+/* main thread: the panel's job when DXMT draws the overlay */
+static void parkour_frame_update(NSString *rows, NSString *status)
+{
+    os_unfair_lock_lock(&parkour_frame_lock);
+    [parkour_frame_rows release];
+    parkour_frame_rows = [rows copy];
+    [parkour_frame_status release];
+    parkour_frame_status = [status copy];
+    parkour_frame_running = parkour_running;
+    parkour_frame_start = parkour_start;
+    os_unfair_lock_unlock(&parkour_frame_lock);
+
+    dispatch_async(parkour_draw_queue, ^{ parkour_frame_render(); });
+    if (parkour_running && !parkour_frame_tick)
+    {
+        parkour_frame_tick = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, parkour_draw_queue);
+        dispatch_source_set_timer(parkour_frame_tick, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC),
+                                  100 * NSEC_PER_MSEC, 5 * NSEC_PER_MSEC);
+        dispatch_source_set_event_handler(parkour_frame_tick, ^{ parkour_frame_render(); });
+        dispatch_resume(parkour_frame_tick);
+    }
+    else if (!parkour_running && parkour_frame_tick)
+    {
+        dispatch_source_cancel(parkour_frame_tick);
+        dispatch_release(parkour_frame_tick);
+        parkour_frame_tick = NULL;
+    }
+}
+
+/* DXMT's present (any thread): returns 1 with the lock held (macdrv_parkour_overlay_unlock), the bitmap and its
+ * version; scale = the drawable's pixels per point */
+__attribute__((visibility("default")))
+int macdrv_parkour_overlay_lock(double scale, uint64_t *version, const void **pixels, uint32_t *width,
+                                uint32_t *height, uint32_t *stride)
+{
+    if (!parkour_enabled()) return 0;
+    os_unfair_lock_lock(&parkour_frame_lock);
+    if (!parkour_frame_seen)
+    {
+        parkour_frame_seen = YES;
+        dispatch_async(dispatch_get_main_queue(), ^{ parkour_redraw(); });   /* hand over from the panel */
+    }
+    if (scale > 0 && fabs(scale - parkour_frame_scale) > 0.01)
+    {
+        parkour_frame_scale = scale;
+        dispatch_async(parkour_draw_queue, ^{ parkour_frame_render(); });
+    }
+    *version = parkour_frame_version;
+    *pixels = parkour_frame_pixels;
+    *width = parkour_frame_width;
+    *height = parkour_frame_height;
+    *stride = parkour_frame_width * 4;
+    return 1;
+}
+
+__attribute__((visibility("default")))
+void macdrv_parkour_overlay_unlock(void)
+{
+    os_unfair_lock_unlock(&parkour_frame_lock);
+}
+
+static BOOL parkour_frame_active(void)
+{
+    BOOL seen;
+
+    os_unfair_lock_lock(&parkour_frame_lock);
+    seen = parkour_frame_seen;
+    os_unfair_lock_unlock(&parkour_frame_lock);
+    return seen;
+}

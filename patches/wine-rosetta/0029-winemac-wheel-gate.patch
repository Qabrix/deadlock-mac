+/* the key's press and release are kept from the game (YES) while parkour is on and the game is in mouse-look */
+int macdrv_parkour_key(unsigned short keycode, int pressed, int repeat, double timestamp)
+{
+    if (keycode >= sizeof(parkour_swallowed) || !parkour_enabled()) return NO;
+    if (keycode != PARKOUR_KEY_Q && keycode != PARKOUR_KEY_E && keycode != PARKOUR_KEY_T && keycode != PARKOUR_KEY_H)
+        return NO;
+    if (keycode == PARKOUR_KEY_E && (!pressed || repeat)) return NO;
+    if (!pressed || repeat)
+    {
+        BOOL swallowed = parkour_swallowed[keycode];
+        if (!pressed) parkour_swallowed[keycode] = 0;
+        return swallowed;
+    }
+    if (!parkour_mouselook()) return NO;
+    parkour_swallowed[keycode] = keycode != PARKOUR_KEY_E;
+
+    switch (keycode)
+    {
+    case PARKOUR_KEY_Q:
+        parkour_ask_position();
+        break;
+    case PARKOUR_KEY_E:
+        if (!parkour_checkpoint) return NO;   /* just Interact */
+        if (!parkour_exec([NSString stringWithFormat:@"%@;noclip 0%s%s", parkour_checkpoint, *parkour_refresh ? ";" : "",
+                                                      parkour_refresh]))
+            parkour_show_status(@"can't run game commands");
+        else if (*parkour_refresh && *parkour_refresh_off)
+        {
+            parkour_off_pending = YES;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(parkour_refresh_ms * NSEC_PER_MSEC)),
+                           dispatch_get_main_queue(), ^{
+                if (parkour_off_pending) parkour_exec(@"");   /* failed: the next command carries it */
+            });
+        }
+        parkour_running = YES;
+        parkour_start = timestamp;
+        parkour_redraw();
+        return NO;   /* Interact too */
+    case PARKOUR_KEY_T:
+        if (parkour_running)
+        {
+            [parkour_rows addObject:parkour_format(timestamp - parkour_start)];
+            if ([parkour_rows count] > 20) [parkour_rows removeObjectAtIndex:0];
+            macdrv_wheel_log("parkour: time %s\n", [[parkour_rows lastObject] UTF8String]);
+            parkour_running = NO;
+        }
+        else
+        {
+            parkour_running = YES;
+            parkour_start = timestamp;
+        }
+        parkour_redraw();
+        break;
+    case PARKOUR_KEY_H:
+        if (![parkour_rows count] && !parkour_running && parkour_checkpoint)
+        {
+            [parkour_checkpoint release];
+            parkour_checkpoint = nil;
+            parkour_show_status(@"checkpoint cleared");
+            break;
+        }
+        [parkour_rows removeAllObjects];
+        parkour_running = NO;
+        [parkour_status release];
+        parkour_status = nil;
+        parkour_redraw();
+        break;
+    }
+    return YES;
+}

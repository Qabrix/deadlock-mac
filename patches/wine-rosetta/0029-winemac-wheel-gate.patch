+/* deadlock-gptk: WINE_MAC_WHEEL_GATE=<ms> - in mouse-look (the client hides and clips the cursor) one wheel flick is
+ * one notch: a vertical scroll event within <ms> of the previous one in the same direction is dropped (every event
+ * extends the window), a kept one is exactly one WHEEL_DELTA. macOS sends several accelerated events per flick, so a
+ * wheel bound to jump also air-jumped (the XMBC "ignore repeated scroll" fix on Windows). Cursor visible (menus,
+ * shop): unchanged. */
+static double wheel_gate_ms(void)
+{
+    static double ms = -1;
+    if (ms < 0)
+    {
+        const char *s = getenv("WINE_MAC_WHEEL_GATE");
+        ms = s && *s ? atof(s) : 0;
+        if (ms < 0) ms = 0;
+    }
+    return ms;
+}
+
+static NSTimeInterval wheel_gate_last;
+static int wheel_gate_dir;
+
+/* deadlock-gptk: WINE_MAC_WHEEL_REPRESS=<mac keycode>[:up|:down][:<ms>] (e.g. 49:up:25 = Space, wheel up, 25 ms) - in
+ * mouse-look, a wheel notch (kept by the gate, in that direction) while that key is physically held becomes a fresh
+ * press of the key: release now, press again <ms> later (more than a game tick, so the game sees the key go up and
+ * down), and the notch itself is dropped. For a key and wheel on the same action (Deadlock: Jump on SPACE +
+ * MWHEELUP) the wheel then works no matter how long the key is held; afterwards the key is down again, as it
+ * physically is. An immediate release + notch landed in one game tick and was no new press. */
+static int wheel_repress_key = -2, wheel_repress_dir, wheel_repress_ms;
+
+static void wheel_repress_init(void)
+{
+    const char *s;
+    char *end;
+
+    if (wheel_repress_key != -2) return;
+    wheel_repress_key = -1;
+    wheel_repress_dir = 0;
+    wheel_repress_ms = 25;
+    if (!(s = getenv("WINE_MAC_WHEEL_REPRESS")) || !*s) return;
+    wheel_repress_key = strtol(s, &end, 0);
+    if (!strncmp(end, ":up", 3)) { wheel_repress_dir = 1; end += 3; }
+    else if (!strncmp(end, ":down", 5)) { wheel_repress_dir = -1; end += 5; }
+    if (*end == ':') wheel_repress_ms = atoi(end + 1);
+    if (wheel_repress_key < 0 || wheel_repress_key > 127) wheel_repress_key = -1;
+}
+
+/* physical key state from the key events Wine receives (CGEventSourceKeyState of the HID state can need Input
+ * Monitoring permission); main thread only, like the scroll handler */
+static unsigned char wheel_keys_down[128];
+static NSTimeInterval wheel_keys_press_time[128];   /* last non-repeat press, NSEvent timestamp (uptime) */
+static BOOL wheel_pending;                          /* a delayed wheel jump is queued */
+
+/* deadlock-gptk: WINE_MAC_WHEEL_RAW_AFTER_PAIR=<pair ms>[:<window ms>] (default off; the launchers set 400:1500) - two
+ * presses of the WINE_MAC_WHEEL_REPRESS key less than <pair ms> apart (Deadlock: Space-Space = jump + air jump) make
+ * the wheel raw for <window ms> after the second press: in that direction every scroll event is a notch (no gate)
+ * and none is held back (no WINE_MAC_WHEEL_AFTER_KEY_MS), for wall jumps at full wheel speed. A single press of
+ * the key ends it (Space -> wheel keeps its hold). A held key is still re-pressed. */
+static double wheel_raw_pair_ms = -1, wheel_raw_window_ms;
+static NSTimeInterval wheel_raw_until;
+
+static void wheel_raw_init(void)
+{
+    const char *s;
+    char *end;
+
+    if (wheel_raw_pair_ms >= 0) return;
+    wheel_raw_pair_ms = 0;
+    wheel_raw_window_ms = 1500;
+    if (!(s = getenv("WINE_MAC_WHEEL_RAW_AFTER_PAIR")) || !*s) return;
+    wheel_raw_pair_ms = strtod(s, &end);
+    if (*end == ':') wheel_raw_window_ms = atof(end + 1);
+    if (wheel_raw_pair_ms < 0) wheel_raw_pair_ms = 0;
+}
+
+void macdrv_wheel_note_key(unsigned short keycode, int pressed, int repeat, double timestamp)
+{
+    if (keycode >= sizeof(wheel_keys_down)) return;
+    wheel_keys_down[keycode] = pressed != 0;
+    if (pressed && !repeat)
+    {
+        double apart = (timestamp - wheel_keys_press_time[keycode]) * 1000;
+
+        wheel_repress_init();
+        wheel_raw_init();
+        if (keycode == wheel_repress_key && apart < wheel_raw_pair_ms)
+        {
+            wheel_raw_until = timestamp + wheel_raw_window_ms / 1000;
+            macdrv_wheel_log("key %d pressed twice %.0f ms apart: wheel raw for %.0f ms\n", keycode, apart,
+                             wheel_raw_window_ms);
+        }
+        else if (keycode == wheel_repress_key && wheel_raw_until > timestamp)
+        {
+            wheel_raw_until = 0;
+            macdrv_wheel_log("key %d pressed once: wheel raw off\n", keycode);
+        }
+        wheel_keys_press_time[keycode] = timestamp;
+    }
+}
+
+/* deadlock-gptk: WINE_MAC_WHEEL_AFTER_KEY_MS=<ms> (default 0 = off; the launchers set 160) - a wheel notch less than
+ * <ms> after the last press of the WINE_MAC_WHEEL_REPRESS key is held back until <ms> after that press. Deadlock's
+ * Jump ability has a 0.15 s cooldown (scripts/abilities.vdata citadel_ability_jump AbilityCooldown), so a wheel jump
+ * 60-140 ms after Space was ignored; now it lands just after the cooldown. One notch is still one press. */
+static double wheel_after_key_ms(void)
+{
+    static double ms = -1;
+    if (ms < 0)
+    {
+        const char *s = getenv("WINE_MAC_WHEEL_AFTER_KEY_MS");
+        ms = s && *s ? atof(s) : 0;
+        if (ms < 0) ms = 0;
+    }
+    return ms;
+}
+
+static void wheel_post_scroll(WineWindow *window, int x, int y, int y_scroll)
+{
+    macdrv_event *event = macdrv_create_event(MOUSE_SCROLL, window);
+
+    event->mouse_scroll.x = x;
+    event->mouse_scroll.y = y;
+    event->mouse_scroll.y_scroll = y_scroll;
+    event->mouse_scroll.look = 1;
+    event->mouse_scroll.time_ms = [[WineApplicationController sharedController]
+                                   ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+    [window.queue postEvent:event];
+    macdrv_release_event(event);
+}
+
+static void wheel_post_key(WineWindow *window, CGKeyCode key, BOOL pressed, CGEventFlags modifiers)
+{
+    macdrv_event *event = macdrv_create_event(pressed ? KEY_PRESS : KEY_RELEASE, window);
+
+    event->key.keycode = key;
+    event->key.modifiers = modifiers;
+    event->key.time_ms = [[WineApplicationController sharedController]
+                          ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+    [window.queue postEvent:event];
+    macdrv_release_event(event);
+}
+
+/* deadlock-gptk: WINE_MAC_WHEEL_LOG=<unix path> - one line per wheel notch and per press/release of the
+ * WINE_MAC_WHEEL_RELEASE key: what the gate and the release did (diagnostics, a few lines per jump). */
+#include <stdarg.h>
+void macdrv_wheel_log(const char *fmt, ...)
+{
+    static FILE *f;
+    static int init;
+    va_list args;
+
+    if (!init)
+    {
+        const char *path = getenv("WINE_MAC_WHEEL_LOG");
+        init = 1;
+        if (path && *path && (f = fopen(path, "a"))) setvbuf(f, NULL, _IOLBF, 0);
+    }
+    if (!f) return;
+    va_start(args, fmt);
+    vfprintf(f, fmt, args);
+    va_end(args);
+}
